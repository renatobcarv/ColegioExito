---
import Base from '../layouts/Base.astro';
import { school } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<Base title={`Página não encontrada | ${school.name}`}>
  <main id="conteudo" class="dark" style="min-height:100vh;display:grid;place-items:center;background:var(--royal);text-align:center;padding:32px 16px">
    <div style="display:grid;gap:22px;justify-items:center">
      <div class="kicker">Erro 404</div>
      <h1 class="disp" style="margin:0;font-size:clamp(40px,7vw,88px);font-weight:760;line-height:1">Essa página <span class="serif">não existe.</span></h1>
      <p class="lead" style="margin:0">Mas a nossa porta está aberta.</p>
      <a href={base} class="pill-sm pill-sm--red" style="height:52px;font-size:16px">Voltar ao início</a>
    </div>
  </main>
</Base>
