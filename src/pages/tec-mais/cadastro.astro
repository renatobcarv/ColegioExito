---
// Cadastro de estudante TEC Mais (substitui o cadastro antigo que só mandava WhatsApp).
// Grava no Supabase pela função tec_cadastrar() (supabase/migrations/0005_cadastros.sql) e a equipe
// vê tudo em /admin/cadastros. Sem Supabase configurado, cai no envio por WhatsApp, como antes.
// Aceita ?curso=<slug> para já vir com o curso escolhido (ex.: /tec-mais/cadastro?curso=enfermagem).
// Página só da TEC Mais: sem menu, rodapé e marca do Colégio Êxito. Mantém o rastreamento (com consentimento).
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/instrument-serif/latin-400.css';
import '../../styles/global.css';
import Tracking from '../../components/Tracking.astro';
import AvisoCookies from '../../components/AvisoCookies.astro';
import Icon from '../../components/Icon.astro';
import { formacoes, waLink } from '../../data/site';

const f = formacoes.find((x) => x.slug === 'tec-mais')!;
const t = f.theme;
const vars = `--p:${t.primary};--pd:${t.primaryDark};--pdeep:${t.primaryDeep};--a:${t.accent};--ai:${t.accentInk};--ab:${t.accentBtn};--soft:${t.soft}`;
const cursos = [
  { grupo: 'Cursos técnicos', itens: (f.technical ?? []).map((c) => ({ slug: c.slug, nome: c.name })) },
  { grupo: 'Cursos rápidos', itens: f.areas.map((a) => ({ slug: (a.href ?? '').split('/').pop() || a.title.toLowerCase(), nome: a.title })) },
];
const env = (...k: string[]) => k.map((x) => process.env[x] ?? (import.meta.env as Record<string, string | undefined>)[x]).find(Boolean) ?? '';
const sbUrl = env('NEXT_PUBLIC_SUPABASE_URL', 'SUPABASE_URL', 'PUBLIC_SUPABASE_URL');
const sbKey = env('NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY', 'NEXT_PUBLIC_SUPABASE_ANON_KEY', 'SUPABASE_PUBLISHABLE_KEY', 'SUPABASE_ANON_KEY', 'PUBLIC_SUPABASE_ANON_KEY');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const titulo = 'Cadastro de estudante | TEC Mais Cursos Técnicos';
const descricao = 'Faça seu cadastro na TEC Mais em 3 passos: dados, endereço e contato. A equipe te chama no WhatsApp para garantir sua vaga.';
const og = new URL(`${base}/img/tec/marca/og-cadastro.jpg`, Astro.site);
const endereco = f.contact.address?.at(-1) ?? 'Valparaíso de Goiás – GO';
const insta = f.contact.instagram ? `@${f.contact.instagram.split('/').filter(Boolean).pop()}` : '';
const UFS = ['Acre', 'Alagoas', 'Amapá', 'Amazonas', 'Bahia', 'Ceará', 'Distrito Federal', 'Espírito Santo', 'Goiás', 'Maranhão', 'Mato Grosso', 'Mato Grosso do Sul', 'Minas Gerais', 'Pará', 'Paraíba', 'Paraná', 'Pernambuco', 'Piauí', 'Rio de Janeiro', 'Rio Grande do Norte', 'Rio Grande do Sul', 'Rondônia', 'Roraima', 'Santa Catarina', 'São Paulo', 'Sergipe', 'Tocantins'];
const INSTRUCAO = ['Ensino Fundamental Incompleto', 'Ensino Fundamental Completo', 'Ensino Médio Incompleto', 'Ensino Médio Completo', 'Ensino Superior Incompleto', 'Ensino Superior Completo', 'Pós-graduação', 'Mestrado', 'Doutorado'];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <Tracking />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={t.primaryDark} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/png" href={`${base}/img/tec/marca/favicon-tecmais.png`} />
    <link rel="apple-touch-icon" href={`${base}/img/tec/marca/apple-touch-tecmais.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="TEC Mais Cursos Técnicos" />
    <meta property="og:title" content="Cadastro de estudante · TEC Mais" />
    <meta property="og:description" content="Falta pouco pra sua vaga. Faça seu cadastro em 3 passos." />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="tm">
    <header class="tm__top" style={vars}>
      <div class="wrap tm__top-in">
        <a href={`${base}/tec-mais`} class="tm__brand" aria-label="TEC Mais Cursos Técnicos">
          <img src={`${base}/img/tec/marca/tec-mais-branco.webp`} alt="TEC Mais Cursos Técnicos" width={f.logo.w} height={f.logo.h} />
        </a>
        <a href={waLink(f.contact.whatsapp, f.whatsappMessage)} target="_blank" rel="noopener" class="tm__wa"><Icon name="whatsapp" size={18} /><span>Dúvidas? Fale com a gente</span></a>
      </div>
    </header>
  <main id="conteudo" class="cad" style={vars} data-sb-url={sbUrl} data-sb-key={sbKey} data-wa={f.contact.whatsapp}>
    <section class="cad__hero">
      <div class="cad__glow" aria-hidden="true"></div>
      <div class="wrap cad__hero-in">
        <span class="mono cad__kicker">Matrículas abertas · Valparaíso de Goiás</span>
        <h1 class="disp cad__t">Cadastro de estudante. <span class="serif">Falta pouco pra sua vaga.</span></h1>
        <p class="cad__lead">São 3 passos rápidos. Digite o CEP e a gente preenche o endereço pra você.</p>
      </div>
    </section>

    <div class="wrap cad__body">
      <ol class="cad__steps" aria-label="Etapas do cadastro">
        <li class="is-on" data-step="1"><b>1</b><span>Dados</span></li>
        <li data-step="2"><b>2</b><span>Endereço</span></li>
        <li data-step="3"><b>3</b><span>Contato</span></li>
      </ol>

      <form id="fCad" class="cad__card" novalidate autocomplete="on">
        <p class="cad__err" id="cadErr" role="alert" hidden></p>
        <input type="text" name="site" class="cad__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <!-- 1 · dados pessoais -->
        <fieldset class="cad__panel is-on" data-panel="1">
          <legend class="disp">Dados pessoais</legend>
          <p class="cad__sub">Quem vai estudar com a gente.</p>
          <div class="cad__grid">
            <label class="cad__f cad__f--full"><span>Curso de interesse <em>obrigatório</em></span>
              <select name="curso" required>
                <option value="">Selecione o curso</option>
                {cursos.map((g) => (
                  <optgroup label={g.grupo}>{g.itens.map((c) => <option value={c.nome} data-slug={c.slug}>{c.nome}</option>)}</optgroup>
                ))}
                <option value="Ainda não sei, quero orientação">Ainda não sei, quero orientação</option>
              </select>
            </label>
            <label class="cad__f cad__f--full"><span>Nome completo <em>obrigatório</em></span>
              <input name="nome" required autocomplete="name" placeholder="Digite o nome completo" maxlength="150" />
            </label>
            <label class="cad__f">CPF
              <input name="cpf" inputmode="numeric" placeholder="000.000.000-00" maxlength="14" data-mask="cpf" />
            </label>
            <label class="cad__f">Data de nascimento
              <input name="nascimento" inputmode="numeric" autocomplete="bday" placeholder="DD/MM/AAAA" maxlength="10" data-mask="data" />
            </label>
            <label class="cad__f cad__f--full">Nome da mãe
              <input name="nome_mae" placeholder="Digite o nome completo" maxlength="150" />
            </label>
            <label class="cad__f">Gênero
              <select name="genero"><option value="">Selecione</option><option>Feminino</option><option>Masculino</option><option>Prefiro não informar</option></select>
            </label>
            <label class="cad__f">Grau de instrução
              <select name="grau_instrucao"><option value="">Selecione</option>{INSTRUCAO.map((x) => <option>{x}</option>)}</select>
            </label>
            <fieldset class="cad__f cad__f--full cad__pills">
              <legend>Estado civil</legend>
              <div>
                {['Solteiro(a)', 'Casado(a)', 'Separado(a)', 'Viúvo(a)'].map((x, i) => (
                  <label><input type="radio" name="estado_civil" value={x} checked={i === 0} /><span>{x}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="cad__f">Estado natal
              <select name="estado_natal"><option value="">Selecione</option>{UFS.map((x) => <option>{x}</option>)}</select>
            </label>
            <label class="cad__f">Cidade natal
              <input name="cidade_natal" placeholder="Digite a cidade natal" maxlength="80" />
            </label>
          </div>
          <div class="cad__acts">
            <span></span>
            <button type="button" class="cad__next" data-go="2">Avançar <Icon name="arrow" size={18} /></button>
          </div>
        </fieldset>

        <!-- 2 · endereço -->
        <fieldset class="cad__panel" data-panel="2">
          <legend class="disp">Endereço</legend>
          <p class="cad__sub">Digite o CEP e o número. O resto a gente preenche.</p>
          <div class="cad__prio">
            <label class="cad__f">CEP
              <input name="cep" inputmode="numeric" autocomplete="postal-code" placeholder="00000-000" maxlength="9" data-mask="cep" />
              <small class="cad__hint" id="cepHint" aria-live="polite"></small>
            </label>
            <label class="cad__f">Número da casa
              <input name="numero" inputmode="numeric" placeholder="Nº" maxlength="20" />
              <span class="cad__check"><input type="checkbox" id="semNumero" /> <label for="semNumero">Sem número</label></span>
            </label>
          </div>
          <div class="cad__grid">
            <label class="cad__f cad__f--full">Rua
              <input name="rua" autocomplete="address-line1" placeholder="Digite a rua" maxlength="150" />
            </label>
            <label class="cad__f">Bairro
              <input name="bairro" placeholder="Digite o bairro" maxlength="100" />
            </label>
            <label class="cad__f"><span>Complemento <span class="cad__opt">opcional</span></span>
              <input name="complemento" placeholder="Casa, apto, bloco…" maxlength="100" />
            </label>
            <label class="cad__f">Cidade
              <input name="cidade" autocomplete="address-level2" placeholder="Digite a cidade" maxlength="80" />
            </label>
            <label class="cad__f">Estado
              <input name="estado" autocomplete="address-level1" placeholder="Ex.: Goiás" maxlength="40" />
            </label>
          </div>
          <div class="cad__acts">
            <button type="button" class="cad__back" data-go="1">Voltar</button>
            <button type="button" class="cad__next" data-go="3">Avançar <Icon name="arrow" size={18} /></button>
          </div>
        </fieldset>

        <!-- 3 · contato -->
        <fieldset class="cad__panel" data-panel="3">
          <legend class="disp">Contato</legend>
          <p class="cad__sub">Último passo. É por aqui que a equipe vai te chamar.</p>
          <div class="cad__grid">
            <label class="cad__f"><span>Celular com DDD <em>obrigatório</em></span>
              <input name="celular" required inputmode="numeric" autocomplete="tel" placeholder="(00) 00000-0000" maxlength="15" data-mask="tel" />
              <span class="cad__check"><input type="checkbox" name="celular_whatsapp" id="isWhats" checked /> <label for="isWhats">Este número é WhatsApp</label></span>
            </label>
            <label class="cad__f"><span>Telefone fixo <span class="cad__opt">opcional</span></span>
              <input name="fixo" inputmode="numeric" placeholder="(00) 0000-0000" maxlength="14" data-mask="tel" />
            </label>
            <label class="cad__f cad__f--full">E-mail
              <input name="email" type="email" autocomplete="email" inputmode="email" placeholder="seuemail@exemplo.com" maxlength="150" />
            </label>
            <label class="cad__lgpd cad__f--full">
              <input type="checkbox" name="consentimento" required />
              <span>Autorizo a TEC Mais a usar estes dados para a minha matrícula e para falar comigo sobre o curso, conforme a <a href={`${base}/privacidade`} target="_blank" rel="noopener">Política de Privacidade</a>.</span>
            </label>
          </div>
          <div class="cad__acts">
            <button type="button" class="cad__back" data-go="2">Voltar</button>
            <button type="submit" class="cad__send"><Icon name="check" size={20} />Enviar cadastro</button>
          </div>
        </fieldset>

        <!-- enviado -->
        <div class="cad__done" id="cadDone" hidden tabindex="-1">
          <span class="cad__done-i"><Icon name="check" size={34} /></span>
          <h2 class="disp">Cadastro enviado, <span id="doneNome"></span>!</h2>
          <p>A equipe da TEC Mais recebeu seus dados e vai te chamar no WhatsApp para confirmar a vaga em <strong id="doneCurso"></strong>.</p>
          <a class="cad__wa" id="doneWa" href={waLink(f.contact.whatsapp)} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />Quero falar agora no WhatsApp</a>
          <p class="cad__small">Lembrete: na matrícula você ganha o Kit do Estudante (mochila, apostilas, uniforme, garrafinha e pulseiras).</p>
        </div>
      </form>

      <p class="cad__lock"><Icon name="check" size={16} />Seus dados ficam guardados com segurança e só a equipe da TEC Mais tem acesso.</p>
    </div>
  </main>
  <footer class="tm__foot" style={vars}>
    <div class="wrap tm__foot-in">
      <img src={`${base}/img/tec/marca/tec-mais-branco.webp`} alt="TEC Mais Cursos Técnicos" width={f.logo.w} height={f.logo.h} loading="lazy" />
      <p>{endereco}</p>
      <p class="tm__links">
        <a href={waLink(f.contact.whatsapp, f.whatsappMessage)} target="_blank" rel="noopener">WhatsApp</a>
        {f.contact.instagram && <a href={f.contact.instagram} target="_blank" rel="noopener">{insta}</a>}
        <a href={`${base}/privacidade`} target="_blank" rel="noopener">Política de Privacidade</a>
      </p>
    </div>
  </footer>
  <AvisoCookies marca="da TEC Mais" />
  </body>
</html>

<script>
  import '../../scripts/cadastro';
</script>

<style>
  /* moldura própria da TEC Mais (sem o menu e o rodapé do Colégio Êxito) */
  :global(body.tm) { background: var(--soft, #F1F1FA); }
  .tm__top { position: sticky; top: 0; z-index: 30; background: var(--pdeep); border-bottom: 1px solid rgba(255,255,255,.12); }
  .tm__top-in { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 68px; }
  .tm__brand { display: inline-flex; }
  .tm__brand img { display: block; width: 150px; height: auto; }
  .tm__wa { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px; background: #25D366; color: #FFF; font-weight: 700; font-size: 14.5px; text-decoration: none; }
  .tm__wa:hover { color: #FFF; filter: brightness(1.05); }
  .tm__foot { background: var(--pdeep); color: rgba(255,255,255,.78); padding: 36px 0 calc(36px + env(safe-area-inset-bottom)); font-size: 14px; }
  .tm__foot-in { display: grid; justify-items: center; gap: 10px; text-align: center; }
  .tm__foot img { width: 150px; height: auto; }
  .tm__foot p { margin: 0; }
  .tm__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; }
  .tm__links a { color: #FFF; font-weight: 600; }
  .cad__kicker { display: inline-block; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--a); }
  @media (max-width: 480px) { .tm__wa span { display: none; } .tm__wa { width: 44px; padding: 0; justify-content: center; } }
  .cad { --ink: #0B1F5C; --mu: #4A5878; background: var(--soft); padding-bottom: 72px; }
  .cad__hero { position: relative; overflow: clip; padding: 40px 0 120px; color: #FFF; background: linear-gradient(160deg, var(--pd), var(--pdeep) 70%); }
  .cad__glow { position: absolute; width: 760px; height: 760px; right: -240px; top: -320px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--a) 40%, transparent), transparent 62%); pointer-events: none; }
  .cad__hero-in { position: relative; max-width: 760px; }
  .cad__t { margin: 14px 0 0; font-size: clamp(32px, 4.4vw, 52px); font-weight: 760; line-height: 1.05; letter-spacing: -.02em; text-wrap: balance; }
  .cad__t .serif { display: block; color: var(--a); font-weight: 400; }
  .cad__lead { margin: 14px 0 0; font-size: 17px; color: rgba(255,255,255,.85); }

  .cad__body { position: relative; margin-top: -80px; max-width: 820px; }
  .cad__steps { list-style: none; margin: 0 0 14px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .cad__steps li { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 16px; background: rgba(255,255,255,.12); color: rgba(255,255,255,.8); font-weight: 700; font-size: 14.5px; border: 1px solid rgba(255,255,255,.2); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: background .25s, color .25s; }
  .cad__steps b { display: grid; place-items: center; width: 28px; height: 28px; flex: none; border-radius: 50%; background: rgba(255,255,255,.18); font-size: 13px; }
  .cad__steps li.is-on { background: #FFF; color: var(--pd); border-color: #FFF; }
  .cad__steps li.is-on b { background: var(--a); color: #FFF; }
  .cad__steps li.is-done { background: color-mix(in srgb, #FFF 88%, var(--a)); color: var(--pd); }
  .cad__steps li.is-done b { background: var(--pd); color: #FFF; }

  .cad__card { position: relative; padding: clamp(22px, 4vw, 40px); border-radius: 28px; background: #FFF; border: 1px solid #E3E8F2; border-top: 5px solid var(--a); box-shadow: 0 40px 80px -50px rgba(11, 31, 92, .6); }
  .cad__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .cad__panel { display: none; margin: 0; padding: 0; border: 0; min-width: 0; }
  .cad__panel.is-on { display: block; animation: cadIn .35s var(--ease); }
  @keyframes cadIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .cad__panel > legend { padding: 0; font-size: clamp(24px, 3vw, 30px); font-weight: 760; color: var(--ink); letter-spacing: -.02em; }
  .cad__sub { margin: 4px 0 22px; color: var(--mu); }
  .cad__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; }
  .cad__f { display: grid; gap: 7px; align-content: start; font-size: 14px; font-weight: 700; color: var(--ink); min-width: 0; margin: 0; padding: 0; border: 0; }
  .cad__f--full { grid-column: 1 / -1; }
  .cad__f em { font-style: normal; font-weight: 600; font-size: 11.5px; color: var(--ai); margin-left: 4px; }
  .cad__opt { font-weight: 500; font-size: 12px; color: var(--mu); margin-left: 4px; }
  .cad__f input:not([type=checkbox]):not([type=radio]), .cad__f select {
    width: 100%; min-height: 52px; padding: 0 16px; border-radius: 14px; border: 1.5px solid #D8DFEC; background: #F7F9FD;
    font: inherit; font-size: 16px; font-weight: 500; color: var(--ink); transition: border-color .2s, box-shadow .2s, background .2s;
  }
  .cad__f input:focus, .cad__f select:focus { outline: none; border-color: var(--a); background: #FFF; box-shadow: 0 0 0 4px color-mix(in srgb, var(--a) 22%, transparent); }
  .cad__f input:disabled { opacity: .5; }
  .cad__f .is-bad, .cad__f .is-bad:focus { border-color: #D93025 !important; box-shadow: 0 0 0 4px rgba(217, 48, 37, .15) !important; }
  .cad__pills legend { padding: 0; margin-bottom: 7px; }
  .cad__pills div { display: flex; flex-wrap: wrap; gap: 8px; }
  .cad__pills label { position: relative; }
  .cad__pills input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .cad__pills span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1.5px solid #D8DFEC; background: #F7F9FD; font-weight: 600; color: var(--mu); transition: all .2s; }
  .cad__pills input:checked + span { background: var(--pd); border-color: var(--pd); color: #FFF; }
  .cad__pills input:focus-visible + span { box-shadow: 0 0 0 4px color-mix(in srgb, var(--a) 30%, transparent); }
  .cad__prio { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; padding: 18px; margin-bottom: 18px; border-radius: 18px; background: color-mix(in srgb, var(--a) 8%, #FFF); border: 1.5px dashed color-mix(in srgb, var(--a) 45%, transparent); }
  .cad__hint { font-weight: 500; font-size: 12.5px; color: var(--mu); min-height: 1em; }
  .cad__hint.ok { color: #1E8B3A; }
  .cad__hint.warn { color: #B8440F; }
  .cad__check { display: flex; align-items: center; gap: 8px; font-weight: 500; font-size: 13.5px; color: var(--mu); }
  .cad__check input, .cad__lgpd input { width: 20px; height: 20px; accent-color: var(--pd); flex: none; }
  .cad__lgpd { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border-radius: 14px; background: var(--soft); font-size: 13.5px; line-height: 1.5; color: var(--mu); font-weight: 500; }
  .cad__lgpd input { margin-top: 2px; }
  .cad__lgpd a { color: var(--pd); font-weight: 700; }
  .cad__lgpd.is-bad { outline: 2px solid #D93025; }

  .cad__acts { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 28px; }
  .cad__next, .cad__send, .cad__back, .cad__wa { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 26px; border-radius: 999px; border: 0; font: inherit; font-weight: 800; font-size: 16px; cursor: pointer; text-decoration: none; transition: transform .25s var(--ease), opacity .2s; }
  .cad__next { background: var(--pd); color: #FFF; }
  .cad__send { background: linear-gradient(180deg, var(--a), var(--ab)); color: #FFF; box-shadow: 0 16px 36px -12px color-mix(in srgb, var(--a) 75%, transparent); }
  .cad__back { background: transparent; color: var(--mu); border: 1.5px solid #D8DFEC; }
  .cad__next:hover, .cad__send:hover { transform: translateY(-2px); }
  .cad__send:disabled { opacity: .6; cursor: progress; transform: none; }
  .cad__err { margin: 0 0 18px; padding: 12px 16px; border-radius: 14px; background: #FDECEB; color: #9B1710; font-weight: 600; font-size: 14.5px; }

