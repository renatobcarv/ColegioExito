---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Bands from '../components/Bands.astro';
import Manifesto from '../components/Manifesto.astro';
import Jornada from '../components/Jornada.astro';
import Acompanhamento from '../components/Acompanhamento.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Unidades from '../components/Unidades.astro';
import Faq from '../components/Faq.astro';
import Visita from '../components/Visita.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Bands />
    <Manifesto />
    <Jornada />
    <Acompanhamento />
    <Depoimentos />
    <Unidades />
    <Faq />
    <Visita />
  </main>
  <Footer />
</Base>
