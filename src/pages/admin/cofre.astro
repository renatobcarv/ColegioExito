---
// Cofre de senhas da escola. Página isolada: sem o layout do site, sem GTM/GA/Pixel,
// fora do sitemap, com noindex e cabeçalhos restritos no vercel.json.
// Setup e regras de acesso: supabase/migrations/0004_cofre.sql e README (seção "Cofre de senhas").
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

const env = (...k: string[]) => k.map((x) => process.env[x] ?? (import.meta.env as Record<string, string | undefined>)[x]).find(Boolean) ?? '';
const sbUrl = env('NEXT_PUBLIC_SUPABASE_URL', 'SUPABASE_URL', 'PUBLIC_SUPABASE_URL');
const sbKey = env('NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY', 'NEXT_PUBLIC_SUPABASE_ANON_KEY', 'SUPABASE_PUBLISHABLE_KEY', 'SUPABASE_ANON_KEY', 'PUBLIC_SUPABASE_ANON_KEY');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <title>Cofre · Colégio Êxito</title>
    <link rel="icon" href={`${base}/favicon.png`} />
  </head>
  <body>
    <div id="app" data-sb-url={sbUrl} data-sb-key={sbKey}>
      <header class="top">
        <div class="top__in">
          <div class="brand">
            <span class="brand__lock" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2.5"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
            </span>
            <span><strong>Cofre</strong> <span class="brand__sub">Colégio Êxito</span></span>
          </div>
          <div class="top__acts" id="topActs" hidden>
            <span class="who mono" id="who"></span>
            <button type="button" class="btn btn--ghost btn--sm" id="btnLock" hidden>Trancar</button>
            <button type="button" class="btn btn--ghost btn--sm" id="btnSair">Sair</button>
          </div>
        </div>
      </header>

      <main class="main">
        <p class="msg" id="msg" role="status" aria-live="polite" hidden></p>

        <!-- sem configuração do Supabase -->
        <section class="card narrow" data-tela="sem-config" hidden>
          <h1>Cofre indisponível</h1>
          <p class="muted">O Supabase não está configurado nesta publicação (faltam <code>NEXT_PUBLIC_SUPABASE_URL</code> e <code>NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY</code>). Você ainda pode <button type="button" class="link" data-ir="backup">abrir um backup</button>.</p>
        </section>

        <!-- 1ª trava: login -->
        <section class="card narrow" data-tela="login" hidden>
          <h1>Entrar</h1>
          <p class="muted">Acesso restrito à equipe autorizada.</p>
          <form id="fLogin" class="form" autocomplete="on">
            <label>E-mail<input type="email" name="email" required autocomplete="username" inputmode="email" /></label>
            <label>Senha de acesso<input type="password" name="senha" required autocomplete="current-password" /></label>
            <button class="btn btn--primary" type="submit">Entrar</button>
          </form>
          <p class="foot-note"><button type="button" class="link" data-ir="backup">Abrir um backup sem internet</button></p>
        </section>

        <!-- logado, mas fora da lista de admins -->
        <section class="card narrow" data-tela="sem-acesso" hidden>
          <h1>Sem permissão</h1>
          <p class="muted">Este e-mail entrou, mas não está autorizado a abrir o cofre. Peça para a direção incluir você na tabela <code>cofre_admins</code> do Supabase.</p>
        </section>

        <!-- 1ª vez: criar senha mestra -->
        <section class="card narrow" data-tela="criar" hidden>
          <h1>Criar a senha mestra</h1>
          <p class="muted">Ela embaralha todas as senhas do cofre antes de saírem deste aparelho. <strong>Ninguém consegue recuperá-la</strong>, nem a TI, nem o Supabase. Anote no papel e guarde num lugar físico seguro.</p>
          <p class="tip">Dica: use uma frase com 4 ou mais palavras que não combinam, como <span class="mono">girafa tomada janeiro piscina 47</span> (não use essa).</p>
          <form id="fCriar" class="form">
            <label>Senha mestra<input type="password" name="m1" required minlength="16" autocomplete="new-password" /></label>
            <div class="meter" id="meterCriar"><i></i><span></span></div>
            <label>Repita a senha mestra<input type="password" name="m2" required autocomplete="new-password" /></label>
            <label class="check"><input type="checkbox" name="ok" required /> Anotei a senha mestra e sei que ela não tem recuperação.</label>
            <button class="btn btn--primary" type="submit">Criar cofre</button>
          </form>
        </section>

        <!-- 2ª trava: senha mestra -->
        <section class="card narrow" data-tela="desbloquear" hidden>
          <h1>Destrancar o cofre</h1>
          <p class="muted">Digite a senha mestra. Ela fica só neste aparelho.</p>
          <form id="fDesb" class="form">
            <label>Senha mestra<input type="password" name="m" required autocomplete="off" /></label>
            <button class="btn btn--primary" type="submit">Destrancar</button>
          </form>
        </section>

        <!-- abrir backup offline -->
        <section class="card narrow" data-tela="backup" hidden>
          <h1>Abrir um backup</h1>
          <p class="muted">Lê um arquivo baixado pelo botão “Baixar backup”, sem internet e sem login. Só leitura.</p>
          <form id="fBackup" class="form">
            <label>Arquivo do backup<input type="file" name="arq" accept="application/json,.json" required /></label>
            <label>Senha mestra da época do backup<input type="password" name="m" required autocomplete="off" /></label>
            <button class="btn btn--primary" type="submit">Abrir</button>
          </form>
          <p class="foot-note"><button type="button" class="link" data-ir="inicio">Voltar</button></p>
        </section>

        <!-- cofre aberto -->
        <section data-tela="cofre" hidden>
          <div class="bar">
            <div class="search">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
              <input type="search" id="busca" placeholder="Buscar conta, usuário ou responsável" aria-label="Buscar" autocomplete="off" />
            </div>
            <button type="button" class="btn btn--primary" id="btnNovo">+ Nova conta</button>
          </div>
          <div class="chips" id="chips" role="group" aria-label="Filtrar por categoria"></div>
          <p class="readonly" id="readonly" hidden>Backup aberto em modo leitura. Nada aqui é gravado.</p>
          <ul class="list" id="lista"></ul>
          <p class="empty" id="vazio" hidden></p>

          <details class="tools" id="tools">
            <summary>Ferramentas do cofre</summary>
            <div class="tools__grid">
              <div class="tool">
                <h2>Baixar backup</h2>
                <p class="muted">Arquivo cifrado com todas as contas. Só abre com a senha mestra atual. Guarde fora do computador (pendrive, Drive da direção).</p>
                <button type="button" class="btn btn--ghost" id="btnBackup">Baixar backup</button>
              </div>
              <div class="tool">
                <h2>Trocar a senha mestra</h2>
                <p class="muted">Faça isso sempre que alguém sair da equipe. Todas as contas são cifradas de novo.</p>
                <form id="fTrocar" class="form">
                  <label>Senha mestra atual<input type="password" name="atual" required autocomplete="off" /></label>
                  <label>Nova senha mestra<input type="password" name="m1" required minlength="16" autocomplete="new-password" /></label>
                  <div class="meter" id="meterTrocar"><i></i><span></span></div>
                  <label>Repita a nova<input type="password" name="m2" required autocomplete="new-password" /></label>
                  <button class="btn btn--ghost" type="submit">Trocar senha mestra</button>
                </form>
              </div>
              <div class="tool tool--wide">
                <h2>Histórico</h2>
                <p class="muted">Quem criou, alterou, apagou ou destrancou. Não mostra nenhum dado das contas.</p>
                <button type="button" class="btn btn--ghost btn--sm" id="btnLog">Carregar histórico</button>
                <ol class="log" id="log"></ol>
              </div>
            </div>
          </details>
        </section>
      </main>

      <dialog class="dlg" id="dlg" aria-labelledby="dlgT">
        <form id="fItem" class="form" method="dialog">
          <h2 id="dlgT">Nova conta</h2>
          <div class="grid2">
            <label>Nome da conta<input name="nome" required maxlength="120" placeholder="Instagram oficial @colegioexito" /></label>
            <label>Categoria<select name="categoria" id="selCat"></select></label>
          </div>
          <label>Endereço de acesso<input name="url" type="url" maxlength="400" placeholder="https://instagram.com" /></label>
          <div class="grid2">
            <label>Usuário ou e-mail<input name="usuario" maxlength="200" autocomplete="off" /></label>
            <label>Senha
              <span class="pw">
                <input name="senha" type="password" maxlength="400" autocomplete="off" id="inSenha" />
                <button type="button" class="btn btn--ghost btn--sm" id="btnVerForm" aria-label="Mostrar senha">Ver</button>
                <button type="button" class="btn btn--ghost btn--sm" id="btnGerar">Gerar</button>
              </span>
            </label>
          </div>
          <div class="meter" id="meterItem"><i></i><span></span></div>
          <div class="grid2">
            <label>E-mail ou telefone de recuperação<input name="recuperacao" maxlength="200" /></label>
            <label>Verificação em 2 etapas
              <select name="doisFatores">
                <option value="">Não informado</option>
                <option value="sim-app">Ativa · app autenticador</option>
                <option value="sim-sms">Ativa · SMS</option>
                <option value="sim-outro">Ativa · outro meio</option>
                <option value="nao">Desativada</option>
              </select>
            </label>
          </div>
          <label>Responsável<input name="responsavel" maxlength="120" placeholder="Quem cuida dessa conta" /></label>
          <label>Observações<textarea name="obs" rows="3" maxlength="2000" placeholder="Códigos de backup do 2FA, onde está o chip, plano contratado…"></textarea></label>
          <div class="dlg__acts">
            <button type="button" class="btn btn--danger btn--sm" id="btnApagar" hidden>Apagar</button>
            <span class="sp"></span>
            <button type="button" class="btn btn--ghost" id="btnCancelar">Cancelar</button>
            <button type="submit" class="btn btn--primary" value="salvar">Salvar</button>
          </div>
        </form>
      </dialog>
    </div>

    <script>
      import '../../scripts/cofre';
    </script>

    <style is:global>
      :root {
        --navy: #0B2A86; --royal: #1237A6; --red: #E1251B; --green: #1E8B3A; --gold: #F2C230;
        --bg: #F4F7FD; --card: #FFFFFF; --ink: #0B1F5C; --muted: #4A5878; --dim: #5E6A85;
        --line: rgba(18, 55, 166, .12); --line2: rgba(18, 55, 166, .22);
        --f: 'Geist Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --mono: 'Geist Mono Variable', ui-monospace, SFMono-Regular, monospace;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 var(--f); }
      [hidden] { display: none !important; }
      h1 { font-size: 24px; letter-spacing: -.02em; margin: 0 0 6px; }
      h2 { font-size: 17px; margin: 0 0 4px; }
      code, .mono { font-family: var(--mono); font-size: .92em; }
      .muted { color: var(--muted); margin: 0 0 14px; }

      .top { background: var(--navy); color: #fff; position: sticky; top: 0; z-index: 10; }
      .top__in { max-width: 1040px; margin: 0 auto; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .brand { display: flex; align-items: center; gap: 10px; font-size: 16px; }
      .brand__lock { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: rgba(255, 255, 255, .14); }
      .brand__sub { opacity: .75; }
      .top__acts { display: flex; align-items: center; gap: 8px; min-width: 0; }
      .who { font-size: 12px; opacity: .8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 220px; }
      @media (max-width: 560px) { .who, .brand__sub { display: none; } }
      .top .btn--ghost { color: #fff; border-color: rgba(255, 255, 255, .35); background: transparent; }
      .top .btn--ghost:hover { background: rgba(255, 255, 255, .12); }

      .main { max-width: 1040px; margin: 0 auto; padding: 24px 16px 64px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 28px; box-shadow: 0 20px 50px -30px rgba(11, 31, 92, .35); }
      .narrow { max-width: 460px; margin: 6vh auto 0; }
      .msg { max-width: 1040px; margin: 0 auto 16px; padding: 12px 16px; border-radius: 12px; background: #E8F5EC; color: #145C27; border: 1px solid rgba(30, 139, 58, .3); }
      .msg.is-err { background: #FDECEB; color: #9B1710; border-color: rgba(225, 37, 27, .3); }
      .tip { font-size: 13.5px; background: var(--bg); border-radius: 12px; padding: 10px 12px; color: var(--muted); }
      .foot-note { margin: 16px 0 0; font-size: 14px; }

      .form { display: grid; gap: 14px; }
      .form label { display: grid; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--muted); }
      .form input, .form select, .form textarea {
        width: 100%; font: inherit; font-size: 16px; color: var(--ink); background: #fff;
        border: 1px solid var(--line2); border-radius: 12px; padding: 11px 12px; min-height: 46px;
      }
      .form textarea { resize: vertical; min-height: 80px; }
      .form input:focus, .form select:focus, .form textarea:focus { outline: 3px solid rgba(18, 55, 166, .25); border-color: var(--royal); }
      .form .check { display: flex; align-items: flex-start; gap: 10px; font-weight: 500; }
      .form .check input { width: 20px; height: 20px; min-height: 0; margin: 2px 0 0; flex: none; }
      .grid2 { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
      @media (max-width: 640px) { .grid2 { grid-template-columns: 1fr; } }
      .pw { display: flex; gap: 6px; }
      .pw input { flex: 1; min-width: 0; font-family: var(--mono); }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 46px; padding: 0 18px;
        border-radius: 999px; border: 1px solid transparent; font: inherit; font-weight: 700; font-size: 15px; cursor: pointer;
        text-decoration: none; white-space: nowrap; transition: background .15s, transform .15s;
      }
      .btn:active { transform: translateY(1px); }
      .btn:disabled { opacity: .55; cursor: progress; }
      .btn--primary { background: var(--royal); color: #fff; }
      .btn--primary:hover { background: var(--navy); }
      .btn--ghost { background: #fff; color: var(--royal); border-color: var(--line2); }
      .btn--ghost:hover { background: var(--bg); }
      .btn--danger { background: #fff; color: var(--red); border-color: rgba(225, 37, 27, .35); }
      .btn--danger:hover { background: #FDECEB; }
      .btn--sm { min-height: 36px; padding: 0 12px; font-size: 13.5px; }
      .link { background: none; border: 0; padding: 0; font: inherit; color: var(--royal); text-decoration: underline; cursor: pointer; }

      .meter { display: flex; align-items: center; gap: 10px; font-size: 12.5px; color: var(--dim); margin-top: -6px; }
      .meter i { flex: 1; height: 6px; border-radius: 6px; background: var(--line); position: relative; overflow: hidden; }
      .meter i::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w, 0%); background: var(--c, var(--red)); transition: width .2s; }
      .meter span { min-width: 84px; text-align: right; }

      .bar { display: flex; gap: 10px; align-items: center; }
      .search { flex: 1; display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line2); border-radius: 999px; padding: 0 16px; min-height: 48px; color: var(--dim); }
      .search input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 16px; color: var(--ink); background: transparent; }
      .search:focus-within { border-color: var(--royal); box-shadow: 0 0 0 3px rgba(18, 55, 166, .2); }
      @media (max-width: 560px) { .bar { flex-direction: column; align-items: stretch; } }
      .chips { display: flex; gap: 6px; overflow-x: auto; padding: 14px 0 6px; scrollbar-width: none; }
      .chips button { flex: none; min-height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line2); background: #fff; color: var(--muted); font: inherit; font-size: 13.5px; font-weight: 600; cursor: pointer; }
      .chips button[aria-pressed='true'] { background: var(--royal); border-color: var(--royal); color: #fff; }
      .chips small { opacity: .7; margin-left: 4px; }
      .readonly { margin: 8px 0 0; padding: 10px 14px; border-radius: 12px; background: #FFF7DB; color: #6B5300; border: 1px solid rgba(242, 194, 48, .5); font-size: 14px; }

      .list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
      .item { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 16px; display: grid; gap: 10px; min-width: 0; }
      .item__head { display: flex; align-items: center; gap: 12px; min-width: 0; }
      .item__ico { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-weight: 800; color: #fff; background: var(--royal); }
      .item__name { min-width: 0; flex: 1; }
      .item__name strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .item__name span { font-size: 12.5px; color: var(--dim); }
      .item__row { display: flex; align-items: center; gap: 6px; min-width: 0; background: var(--bg); border-radius: 12px; padding: 4px 4px 4px 12px; }
      .item__row > span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); font-size: 13.5px; }
      .item__row > em { font-style: normal; font-size: 11.5px; color: var(--dim); flex: none; width: 54px; }
      .item__row .btn--sm { min-height: 32px; padding: 0 10px; font-size: 12.5px; }
      .item__meta { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; }
      .tag { padding: 3px 9px; border-radius: 999px; background: var(--bg); color: var(--muted); }
      .tag--ok { background: #E8F5EC; color: #145C27; }
      .tag--warn { background: #FDECEB; color: #9B1710; }
      .item__foot { display: flex; gap: 6px; justify-content: flex-end; }
      .empty { text-align: center; color: var(--dim); padding: 40px 16px; }

      .tools { margin-top: 32px; background: var(--card); border: 1px solid var(--line); border-radius: 18px; }
      .tools summary { cursor: pointer; padding: 16px 20px; font-weight: 700; }
      .tools__grid { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; padding: 0 20px 20px; }
      @media (max-width: 760px) { .tools__grid { grid-template-columns: 1fr; } }
      .tool { border: 1px solid var(--line); border-radius: 14px; padding: 16px; }
      .tool--wide { grid-column: 1 / -1; }
      .log { margin: 12px 0 0; padding-left: 20px; font-size: 13.5px; color: var(--muted); max-height: 280px; overflow: auto; }

      .dlg { width: min(640px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); border: 0; border-radius: 20px; padding: 24px; color: var(--ink); box-shadow: 0 40px 100px -30px rgba(0, 0, 0, .5); }
      .dlg::backdrop { background: rgba(11, 31, 92, .45); }
      .dlg__acts { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
      .dlg__acts .sp { flex: 1; }
      @media (max-width: 480px) { .dlg { padding: 18px; } .dlg__acts .btn:not(.btn--sm) { flex: 1; } }
    </style>
  </body>
</html>
