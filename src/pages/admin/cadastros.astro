---
// Painel da equipe TEC Mais: cadastros feitos em /tec-mais/cadastro.
// Página isolada (sem rastreamento, noindex, cabeçalhos de /admin no vercel.json).
// Acesso: login do Supabase + e-mail na tabela tec_equipe (supabase/migrations/0005_cadastros.sql).
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

const env = (...k: string[]) => k.map((x) => process.env[x] ?? (import.meta.env as Record<string, string | undefined>)[x]).find(Boolean) ?? '';
const sbUrl = env('NEXT_PUBLIC_SUPABASE_URL', 'SUPABASE_URL', 'PUBLIC_SUPABASE_URL');
const sbKey = env('NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY', 'NEXT_PUBLIC_SUPABASE_ANON_KEY', 'SUPABASE_PUBLISHABLE_KEY', 'SUPABASE_ANON_KEY', 'PUBLIC_SUPABASE_ANON_KEY');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const STATUS = ['Novo', 'Em contato', 'Matriculado', 'Não fechou'];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Cadastros · TEC Mais</title>
    <link rel="icon" href={`${base}/favicon.png`} />
  </head>
  <body>
    <div id="app" data-sb-url={sbUrl} data-sb-key={sbKey} data-status={JSON.stringify(STATUS)}>
      <header class="top">
        <div class="top__in">
          <div class="brand">
            <img src={`${base}/img/parceiros/tec-mais.webp`} alt="TEC Mais" width="720" height="203" />
            <span>Cadastros</span>
          </div>
          <div class="top__acts" id="topActs" hidden>
            <span class="who mono" id="who"></span>
            <button type="button" class="btn btn--ghost btn--sm" id="btnSair">Sair</button>
          </div>
        </div>
      </header>

      <main class="main">
        <p class="msg" id="msg" role="status" aria-live="polite" hidden></p>

        <section class="card narrow" data-tela="sem-config" hidden>
          <h1>Painel indisponível</h1>
          <p class="muted">O Supabase não está configurado nesta publicação.</p>
        </section>

        <section class="card narrow" data-tela="login" hidden>
          <h1>Entrar</h1>
          <p class="muted">Acesso restrito à equipe da TEC Mais.</p>
          <form id="fLogin" class="form">
            <label>E-mail<input type="email" name="email" required autocomplete="username" inputmode="email" /></label>
            <label>Senha<input type="password" name="senha" required autocomplete="current-password" /></label>
            <button class="btn btn--primary" type="submit">Entrar</button>
          </form>
        </section>

        <section class="card narrow" data-tela="sem-acesso" hidden>
          <h1>Sem permissão</h1>
          <p class="muted">Este e-mail entrou, mas não está liberado para ver os cadastros. Peça para a direção incluir você na tabela <code>tec_equipe</code> do Supabase.</p>
        </section>

        <section data-tela="painel" hidden>
          <div class="head">
            <div>
              <h1>Cadastros de estudantes</h1>
              <p class="muted" id="sub">Feitos pelo site em /tec-mais/cadastro.</p>
            </div>
            <div class="head__acts">
              <button type="button" class="btn btn--ghost" id="btnAtualizar">Atualizar</button>
              <button type="button" class="btn btn--ghost" id="btnCsv">Baixar planilha</button>
              <a class="btn btn--primary" href={`${base}/tec-mais/cadastro`} target="_blank" rel="noopener">Abrir formulário</a>
            </div>
          </div>

          <ul class="kpis" id="kpis"></ul>

          <div class="filters">
            <div class="search">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
              <input type="search" id="busca" placeholder="Buscar por nome, CPF, telefone, e-mail ou cidade" aria-label="Buscar" autocomplete="off" />
            </div>
            <select id="fCurso" aria-label="Filtrar por curso"><option value="">Todos os cursos</option></select>
            <select id="fPeriodo" aria-label="Filtrar por período">
              <option value="">Todo o período</option>
              <option value="7">Últimos 7 dias</option>
              <option value="30">Últimos 30 dias</option>
            </select>
          </div>
          <div class="chips" id="chips" role="group" aria-label="Filtrar por status"></div>

          <div class="tbl-wrap">
            <table class="tbl">
              <thead>
                <tr><th>Data</th><th>Nome</th><th>Curso</th><th>Celular</th><th>Cidade</th><th>Status</th><th><span class="sr">Ações</span></th></tr>
              </thead>
              <tbody id="linhas"></tbody>
            </table>
          </div>
          <p class="empty" id="vazio" hidden></p>
        </section>
      </main>

      <dialog class="dlg" id="dlg" aria-labelledby="dlgT">
        <div class="dlg__head">
          <div>
            <h2 id="dlgT"></h2>
            <p class="muted" id="dlgSub"></p>
          </div>
          <button type="button" class="btn btn--ghost btn--sm" id="btnFechar" aria-label="Fechar">Fechar</button>
        </div>
        <div class="dlg__acts">
          <a class="btn btn--wa" id="dlgWa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <label class="st">Status <select id="dlgStatus"></select></label>
        </div>
        <div class="det" id="det"></div>
        <form id="fObs" class="form">
          <label>Observações da equipe<textarea name="obs" rows="3" maxlength="2000" placeholder="Ex.: ligou dia 20, volta a falar na sexta; prefere turma de março."></textarea></label>
          <div class="dlg__foot">
            <button type="button" class="btn btn--danger btn--sm" id="btnApagar">Apagar cadastro</button>
            <button type="submit" class="btn btn--primary">Salvar observação</button>
          </div>
        </form>
      </dialog>
    </div>

    <script>
      import '../../scripts/cadastros-admin';
    </script>

    <style is:global>
      :root {
        --navy: #00003D; --p: #1A1A8C; --pd: #000066; --a: #F06022; --ai: #B8440F;
        --bg: #F1F1FA; --card: #FFF; --ink: #0B1F5C; --muted: #4A5878; --dim: #5E6A85;
        --line: rgba(26, 26, 140, .12); --line2: rgba(26, 26, 140, .22);
        --f: 'Geist Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --mono: 'Geist Mono Variable', ui-monospace, SFMono-Regular, monospace;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 var(--f); }
      [hidden] { display: none !important; }
      h1 { font-size: 26px; letter-spacing: -.02em; margin: 0 0 4px; }
      h2 { font-size: 20px; margin: 0; }
      code, .mono { font-family: var(--mono); font-size: .92em; }
      .muted { color: var(--muted); margin: 0; }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

      .top { background: var(--pd); color: #fff; position: sticky; top: 0; z-index: 10; }
      .top__in { max-width: 1280px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .brand { display: flex; align-items: center; gap: 12px; font-weight: 700; }
      .brand img { width: 96px; height: auto; background: #fff; border-radius: 10px; padding: 6px 9px; }
      .top__acts { display: flex; align-items: center; gap: 10px; min-width: 0; }
      .who { font-size: 12px; opacity: .8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 240px; }
      .top .btn--ghost { color: #fff; border-color: rgba(255,255,255,.35); background: transparent; }
      @media (max-width: 560px) { .who { display: none; } }

      .main { max-width: 1280px; margin: 0 auto; padding: 24px 16px 64px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 28px; box-shadow: 0 20px 50px -30px rgba(11, 31, 92, .35); }
      .narrow { max-width: 440px; margin: 6vh auto 0; }
      .narrow .muted { margin-bottom: 16px; }
      .msg { margin: 0 0 16px; padding: 12px 16px; border-radius: 12px; background: #E8F5EC; color: #145C27; border: 1px solid rgba(30,139,58,.3); }
      .msg.is-err { background: #FDECEB; color: #9B1710; border-color: rgba(225,37,27,.3); }

      .form { display: grid; gap: 14px; }
      .form label { display: grid; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--muted); }
      .form input, .form textarea, select { width: 100%; font: inherit; font-size: 16px; color: var(--ink); background: #fff; border: 1px solid var(--line2); border-radius: 12px; padding: 10px 12px; min-height: 46px; }
      .form textarea { resize: vertical; }
      input:focus, select:focus, textarea:focus { outline: 3px solid rgba(240, 96, 34, .25); border-color: var(--a); }

      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid transparent; font: inherit; font-weight: 700; font-size: 14.5px; cursor: pointer; text-decoration: none; white-space: nowrap; }
      .btn:disabled { opacity: .55; cursor: progress; }
      .btn--primary { background: var(--a); color: #fff; }
      .btn--primary:hover { background: #D9531A; }
      .btn--ghost { background: #fff; color: var(--p); border-color: var(--line2); }
      .btn--ghost:hover { background: var(--bg); }
      .btn--danger { background: #fff; color: #C8102E; border-color: rgba(200,16,46,.35); }
      .btn--wa { background: #25D366; color: #fff; }
      .btn--sm { min-height: 34px; padding: 0 12px; font-size: 13px; }

      .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
      .head__acts { display: flex; gap: 8px; flex-wrap: wrap; }
      .kpis { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
      .kpis li { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; }
      .kpis strong { display: block; font-size: 28px; letter-spacing: -.02em; line-height: 1.1; }
      .kpis span { font-size: 12.5px; color: var(--muted); }
      .kpis li:first-child { background: var(--pd); color: #fff; border-color: var(--pd); }
      .kpis li:first-child span { color: rgba(255,255,255,.75); }
      @media (max-width: 860px) { .kpis { grid-template-columns: repeat(2, 1fr); } .kpis li:first-child { grid-column: 1 / -1; } }

      .filters { display: grid; grid-template-columns: 1fr 240px 180px; gap: 10px; margin-top: 20px; }
      @media (max-width: 760px) { .filters { grid-template-columns: 1fr 1fr; } .search { grid-column: 1 / -1; } }
      .search { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line2); border-radius: 999px; padding: 0 16px; min-height: 46px; color: var(--dim); }
      .search input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 16px; color: var(--ink); background: transparent; }
      .filters select { border-radius: 999px; }
      .chips { display: flex; gap: 6px; overflow-x: auto; padding: 12px 0 4px; scrollbar-width: none; }
      .chips button { flex: none; min-height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line2); background: #fff; color: var(--muted); font: inherit; font-size: 13.5px; font-weight: 600; cursor: pointer; }
      .chips button[aria-pressed='true'] { background: var(--pd); border-color: var(--pd); color: #fff; }
      .chips small { opacity: .7; margin-left: 4px; }

      .tbl-wrap { margin-top: 12px; background: var(--card); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
      .tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
      .tbl th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--dim); padding: 12px 14px; background: #FAFAFE; border-bottom: 1px solid var(--line); }
      .tbl td { padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: middle; }
      .tbl tr:last-child td { border-bottom: 0; }
      .tbl tbody tr { cursor: pointer; transition: background .15s; }
      .tbl tbody tr:hover { background: #F8F8FE; }
      .tbl .nome { font-weight: 700; }
      .tbl .dup { margin-left: 6px; font-size: 11px; font-weight: 700; color: #8A6D00; background: #FFF7DB; border-radius: 999px; padding: 2px 8px; }
      .tbl .data { white-space: nowrap; color: var(--muted); font-family: var(--mono); font-size: 12.5px; }
      .tbl a { color: var(--p); font-weight: 600; text-decoration: none; white-space: nowrap; }
      .tbl select { min-height: 34px; padding: 4px 8px; font-size: 13.5px; border-radius: 999px; width: auto; }
      .tbl select[data-st='Novo'] { background: #EEF2FF; border-color: #C7D2FE; }
      .tbl select[data-st='Em contato'] { background: #FFF7DB; border-color: #F2D675; }
      .tbl select[data-st='Matriculado'] { background: #E8F5EC; border-color: #9FD5B0; }
      .tbl select[data-st='Não fechou'] { background: #F3F4F6; color: var(--dim); }
      .empty { text-align: center; color: var(--dim); padding: 40px 16px; }

      @media (max-width: 760px) {
        .tbl thead { display: none; }
        .tbl, .tbl tbody, .tbl tr, .tbl td { display: block; width: 100%; }
        .tbl tr { padding: 12px 14px; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; }
        .tbl td { padding: 0; border: 0; }
        .tbl td.nome { grid-column: 1; }
        .tbl td.data { grid-column: 2; grid-row: 1; text-align: right; }
        .tbl td.curso, .tbl td.cidade { grid-column: 1 / -1; color: var(--muted); font-size: 13px; }
        .tbl td.cel { grid-column: 1; }
        .tbl td.stt { grid-column: 2; grid-row: 4; justify-self: end; }
        .tbl td.act { display: none; }
      }

      .dlg { width: min(760px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); border: 0; border-radius: 20px; padding: 24px; color: var(--ink); box-shadow: 0 40px 100px -30px rgba(0,0,0,.5); }
      .dlg::backdrop { background: rgba(0, 0, 61, .45); }
      .dlg__head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
      .dlg__acts { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: 16px 0; }
      .st { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--muted); }
      .st select { width: auto; min-height: 42px; border-radius: 999px; }
      .det { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 24px; margin-bottom: 16px; }
      .det section { grid-column: 1 / -1; margin-top: 10px; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--a); font-weight: 700; }
      .det div { display: grid; grid-template-columns: 130px 1fr; gap: 8px; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
      .det dt { color: var(--muted); }
      .det dd { margin: 0; font-weight: 600; word-break: break-word; }
      .det .cp { border: 0; background: none; color: var(--p); font: inherit; font-size: 12px; cursor: pointer; padding: 0 0 0 6px; }
      @media (max-width: 640px) { .det { grid-template-columns: 1fr; } .det div { grid-template-columns: 110px 1fr; } .dlg { padding: 18px; } }
      .dlg__foot { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    </style>
  </body>
</html>
