---
import '../styles/global.css';
import { school } from '../data/site';
import { units, faqs } from '../data/content';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${school.name} — Matrículas ${school.enrollmentYear} | Novo Gama e Valparaíso`, description = school.description } =
  Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/img/og-image.jpg`, Astro.site);

// Dados estruturados (Google): uma organização com duas unidades + FAQ
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'EducationalOrganization',
      '@id': `${Astro.site}#org`,
      name: school.name,
      slogan: school.slogan,
      foundingDate: String(school.foundedYear),
      url: Astro.site?.toString(),
      logo: new URL(`${base}/img/logo-quadrado.jpg`, Astro.site).toString(),
      sameAs: Object.values(school.social),
      subOrganization: units.map((u) => ({ '@id': `${Astro.site}#${u.id}` })),
    },
    ...units.map((u) => ({
      '@type': 'School',
      '@id': `${Astro.site}#${u.id}`,
      name: `${school.name} — ${u.tag} ${u.city}`,
      parentOrganization: { '@id': `${Astro.site}#org` },
      telephone: u.phones.map((p) => `+55${p.number}`),
      hasMap: u.mapsUrl,
      address: {
        '@type': 'PostalAddress',
        streetAddress: u.address[0],
        addressLocality: u.geo?.locality,
        addressRegion: u.geo?.region,
        postalCode: u.geo?.postalCode,
        addressCountry: 'BR',
      },
    })),
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1237A6" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={school.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="prog" aria-hidden="true"></div>
    <slot />
    <script>
      // Entrada ao rolar, com escalonamento dentro de .stagger
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLElement>('.stagger').forEach((g) =>
        [...g.querySelectorAll<HTMLElement>(':scope > .rv')].forEach((el, i) => el.style.setProperty('--d', `${Math.min(i, 6) * 90}ms`)),
      );
      const els = document.querySelectorAll<HTMLElement>('.rv');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }

      // Números que contam do zero quando aparecem (ex.: "37 anos", "7,8 mil")
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const run = (el: HTMLElement) => {
        const node = [...el.childNodes].find((n) => n.nodeType === 3 && /\d/.test(n.textContent ?? ''));
        if (!node) return;
        const raw = node.textContent ?? '';
        const m = raw.match(/(\d+(?:,\d+)?)/);
        if (!m) return;
        const target = parseFloat(m[1].replace(',', '.'));
        const dec = m[1].includes(',') ? 1 : 0;
        const t0 = performance.now();
        const dur = 1400;
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const v = target * (1 - Math.pow(1 - p, 3));
          node.textContent = raw.replace(m[1], v.toFixed(dec).replace('.', ','));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      if (!reduce && 'IntersectionObserver' in window) {
        const co = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { run(e.target as HTMLElement); co.unobserve(e.target); }
        }), { threshold: 0.6 });
        counters.forEach((c) => co.observe(c));
      }
    </script>
  </body>
</html>
