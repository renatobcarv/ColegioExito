---
import { school } from '../data/site';
import { gallery } from '../data/content';
import Icon from './Icon.astro';

const fmt = (d: string | null) =>
  d ? new Date(`${d}T12:00:00`).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) : null;
---

<section id="vida" class="vida" data-accent="red" aria-labelledby="vida-t">
  <div class="wrap vida__grid">
    <div class="vida__text rv">
      <div class="kicker">Vida no Êxito</div>
      <h2 id="vida-t" class="disp h2">O dia a dia que <span class="serif">não cabe no boletim.</span></h2>
      <p class="lead">
        Projetos, apresentações, datas especiais e a rotina de quem aprende de verdade. Acompanhe tudo pelo nosso
        Instagram.
      </p>
      <div class="vida__ig">
        <span class="vida__ig-av" aria-hidden="true"><Icon name="instagram" size={26} /></span>
        <div>
          <strong>{school.instagramHandle}</strong>
          <span>7,8 mil famílias acompanham</span>
        </div>
      </div>
      <div class="vida__ctas">
        <a href={school.instagramReels} target="_blank" rel="noopener" class="pill-sm vida__follow"><Icon name="instagram" size={18} />Ver todos os reels</a>
        <a href={school.social.instagram} target="_blank" rel="noopener" class="ghost ghost--sm">Seguir no Instagram</a>
      </div>
    </div>

    <div class="vida__reel rv">
      <div class="phone">
        <iframe
          src={`https://www.instagram.com/reel/${school.featuredReel}/embed/`}
          title="Reel do Colégio Êxito no Instagram"
          loading="lazy"
          allow="autoplay; encrypted-media; picture-in-picture; clipboard-write"
          allowfullscreen
        ></iframe>
      </div>
      <a href={`https://www.instagram.com/reel/${school.featuredReel}/`} target="_blank" rel="noopener" class="mono vida__open">
        Abrir no Instagram <Icon name="external" size={14} />
      </a>
    </div>
  </div>

  {
    gallery.length > 0 && (
      <div class="gal" aria-roledescription="carrossel" aria-label="Fotos das atividades">
        <div class="wrap gal__head">
          <h3 class="disp">Atividades que já aconteceram</h3>
          <div class="gal__nav">
            <span class="mono gal__count" aria-live="polite"><span data-cur>1</span> / {gallery.length}</span>
            <button type="button" class="gal__btn" data-dir="-1" aria-label="Foto anterior"><Icon name="arrow" size={20} class="flip" /></button>
            <button type="button" class="gal__btn" data-dir="1" aria-label="Próxima foto"><Icon name="arrow" size={20} /></button>
          </div>
        </div>
        <ul class="gal__track" tabindex="0">
          {gallery.map((g, i) => (
            <li class="gal__item">
              <button type="button" class="gal__open" data-src={g.photo} data-title={g.title} data-caption={g.caption ?? ''} aria-label={`Ampliar foto: ${g.title}`}>
                <img src={g.photo} alt={g.caption ? `${g.title}: ${g.caption}` : g.title} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
              </button>
              <div class="gal__cap">
                <strong>{g.title}</strong>
                {(g.caption || g.date) && <span>{[g.caption, fmt(g.date)].filter(Boolean).join(' · ')}</span>}
              </div>
            </li>
          ))}
        </ul>
        <dialog class="lb" aria-label="Foto ampliada">
          <button type="button" class="lb__close" aria-label="Fechar">×</button>
          <img alt="" />
          <p class="lb__cap"></p>
        </dialog>
      </div>
    )
  }
</section>

<script>
  const track = document.querySelector<HTMLElement>('.gal__track');
  if (track) {
    const items = [...track.querySelectorAll<HTMLElement>('.gal__item')];
    const cur = document.querySelector('[data-cur]');
    const step = () => (items[0]?.offsetWidth ?? 300) + 20;
    document.querySelectorAll<HTMLButtonElement>('.gal__btn').forEach((b) =>
      b.addEventListener('click', () => {
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        const dir = Number(b.dataset.dir);
        if (dir > 0 && atEnd) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: step() * dir, behavior: 'smooth' });
      }),
    );
    track.addEventListener('scroll', () => {
      if (cur) cur.textContent = String(Math.min(items.length, Math.round(track.scrollLeft / step()) + 1));
    }, { passive: true });

    // foto ampliada
    const lb = document.querySelector<HTMLDialogElement>('.lb');
    const img = lb?.querySelector('img');
    const cap = lb?.querySelector('.lb__cap');
    track.querySelectorAll<HTMLButtonElement>('.gal__open').forEach((b) =>
      b.addEventListener('click', () => {
        if (!lb || !img || !cap) return;
        img.src = b.dataset.src ?? '';
        img.alt = b.dataset.title ?? '';
        cap.textContent = [b.dataset.title, b.dataset.caption].filter(Boolean).join(' · ');
        lb.showModal();
      }),
    );
    lb?.querySelector('.lb__close')?.addEventListener('click', () => lb.close());
    lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
</script>

<style>
  .vida { padding: clamp(80px, 10vw, 130px) 0; position: relative; overflow: hidden; }
  .vida__grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
  .vida__text .lead { margin: 22px 0 0; max-width: 520px; }
  .vida__ig { display: flex; align-items: center; gap: 14px; margin-top: 30px; }
  .vida__ig-av {
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; color: #FFFFFF;
    background: conic-gradient(from 200deg, var(--gold), var(--red), #C13584, var(--royal), var(--gold));
    box-shadow: 0 0 0 4px #FFFFFF, 0 0 0 6px var(--line2);
  }
  .vida__ig strong { display: block; font-size: 17px; }
  .vida__ig span { font-size: 14px; color: var(--muted); }
  .vida__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .vida__follow { height: 52px; padding: 0 22px; font-size: 15px; background: var(--green); }

  .vida__reel { display: grid; justify-items: center; gap: 14px; }
  .phone {
    width: min(360px, 100%); aspect-ratio: 9 / 17; border-radius: 40px; padding: 10px; background: #0B1433;
    box-shadow: 0 50px 90px -40px rgba(11, 31, 92, .7), inset 0 0 0 2px rgba(255, 255, 255, .08);
    transition: transform .6s var(--ease);
  }
  .phone:hover { transform: translateY(-6px) rotate(-1deg); }
  .phone iframe { width: 100%; height: 100%; border: 0; border-radius: 30px; background: #FFFFFF; }
  .vida__open { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; letter-spacing: .06em; color: var(--muted); text-decoration: none; }
  .vida__open:hover { color: var(--royal); }

  .gal { margin-top: clamp(64px, 8vw, 100px); }
  .gal__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
  .gal__head h3 { margin: 0; font-size: clamp(24px, 2.6vw, 34px); font-weight: 720; letter-spacing: -.025em; }
  .gal__nav { display: flex; align-items: center; gap: 10px; }
  .gal__count { font-size: 13px; color: var(--muted); margin-right: 6px; }
  .gal__btn {
    width: 50px; height: 50px; border-radius: 50%; border: 1px solid var(--line2); background: #FFFFFF; color: var(--cream);
    display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s, transform .2s var(--ease);
  }
  .gal__btn:hover { background: var(--green); color: #FFFFFF; transform: scale(1.06); }
  .gal__btn :global(.flip) { transform: rotate(180deg); }

  .gal__track {
    list-style: none; margin: 0; display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding: 4px max(16px, calc((100% - 1200px) / 2)) 24px; scroll-padding-inline: max(16px, calc((100% - 1200px) / 2));
  }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__item { flex: 0 0 clamp(260px, 34vw, 420px); scroll-snap-align: start; }
  .gal__open { display: block; width: 100%; padding: 0; border: 0; border-radius: 22px; overflow: hidden; cursor: zoom-in; aspect-ratio: 4 / 3; background: var(--ink3); }
  .gal__open img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .gal__open:hover img { transform: scale(1.06); }
  .gal__cap { padding: 14px 4px 0; display: grid; gap: 2px; }
  .gal__cap strong { font-size: 16px; }
  .gal__cap span { font-size: 14px; color: var(--muted); }

  .lb { max-width: min(1100px, 94vw); max-height: 92vh; padding: 0; border: 0; border-radius: 20px; background: #0B1433; color: #FFFFFF; overflow: hidden; }
  .lb::backdrop { background: rgba(5, 12, 35, .82); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .lb img { display: block; max-width: 100%; max-height: 80vh; margin: 0 auto; }
  .lb__cap { margin: 0; padding: 14px 20px 18px; font-size: 15px; }
  .lb__close { position: absolute; top: 10px; right: 10px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(0, 0, 0, .5); color: #FFFFFF; font-size: 26px; cursor: pointer; }

  @media (max-width: 899px) {
    .vida__grid { grid-template-columns: 1fr; gap: 44px; }
    .gal__item { flex-basis: 80%; }
  }
</style>
