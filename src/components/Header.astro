---
import { school, formatPhone, telLink, formacoes } from '../data/site';
import { units } from '../data/content';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

type Item = { label: string; href: string; desc?: string };
type Group = { label: string; id: string; items: Item[]; active?: boolean };

const ensino: Item[] = [
  { label: 'Proposta pedagógica', href: `${home}#metodologia`, desc: 'Como ensinamos e por que somos diferentes' },
  { label: 'Berçário e Educação Infantil', href: `${home}#seg-educacao-infantil`, desc: 'Rotina, afeto e primeiras descobertas' },
  { label: 'Fundamental I', href: `${home}#seg-fundamental-i`, desc: '1º ao 5º ano' },
  { label: 'Fundamental II', href: `${home}#seg-fundamental-ii`, desc: '6º ao 9º ano' },
  { label: 'Ensino Médio', href: `${home}#seg-ensino-medio`, desc: '1ª a 3ª série, foco em ENEM' },
];
const formacao: Item[] = formacoes.map((f) => ({ label: f.name, href: `${base}/${f.slug}`, desc: f.kind }));

const groups: Group[] = [
  { label: 'Ensino', id: 'dd-ensino', items: ensino },
  { label: 'Formação profissional', id: 'dd-formacao', items: formacao, active: formacoes.some((f) => path.endsWith(`/${f.slug}`)) },
];
const links: Item[] = [
  { label: 'Vida no Êxito', href: `${home}#vida` },
  { label: 'Unidades', href: `${home}#unidades` },
  { label: 'Dúvidas', href: `${home}#duvidas` },
];
const isCurrent = (href: string) => !href.includes('#') && path.endsWith(href.replace(base, ''));
---

<div class="topbar dark">
  <div class="wrap topbar__in">
    <span class="topbar__phones">
      {
        units.map((u) => (
          <span>
            {u.tag} · {u.city.replace(' de Goiás', '')}{' '}
            {u.phones[0] && <a href={telLink(u.phones[0].number)}>{formatPhone(u.phones[0].number)}</a>}
          </span>
        ))
      }
    </span>
    <span class="topbar__social">
      <a href={school.instagramReels} target="_blank" rel="noopener" aria-label="Instagram do Colégio Êxito"><Icon name="instagram" size={16} /><span>{school.instagramHandle}</span></a>
      <a href={school.social.facebook} target="_blank" rel="noopener" aria-label="Facebook do Colégio Êxito"><Icon name="facebook" size={16} /></a>
    </span>
  </div>
</div>

<header class="nav" id="nav">
  <div class="wrap nav__in">
    <a href={home} class="nav__logo" aria-label={`${school.name}, página inicial`}>
      <img src={`${base}/img/logo-horizontal.png`} alt={`${school.name}: ${school.slogan}`} width="277" height="50" />
    </a>

    <nav aria-label="Principal" class="nav__menu" id="menu">
      <ul class="nav__list">
        {
          groups.map((g) => (
            <li class="dd">
              <button type="button" class={`nav__link dd__btn${g.active ? ' is-active' : ''}`} aria-expanded="false" aria-controls={g.id}>
                {g.label}
                <Icon name="chevron" size={16} class="dd__chev" />
              </button>
              <ul class="dd__panel" id={g.id}>
                {g.items.map((it) => (
                  <li>
                    <a href={it.href} class="dd__item" aria-current={isCurrent(it.href) ? 'page' : undefined}>
                      <strong>{it.label}</strong>
                      {it.desc && <span>{it.desc}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
        {links.map((l) => <li><a href={l.href} class="nav__link">{l.label}</a></li>)}
      </ul>
      <a href={`${home}#visita`} class="pill-sm pill-sm--red nav__cta-m">Agendar visita</a>
    </nav>

    <div class="nav__actions">
      <a href={`${home}#visita`} class="pill-sm pill-sm--red nav__cta">Agendar visita</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path class="l1" d="M4 7h16"></path><path class="l2" d="M4 12h16"></path><path class="l3" d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="tricolor" aria-hidden="true"><span></span><span></span><span></span></div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('menu');
  const dds = [...document.querySelectorAll<HTMLButtonElement>('.dd__btn')];

  const closeDds = (except?: HTMLButtonElement) =>
    dds.forEach((b) => b !== except && b.setAttribute('aria-expanded', 'false'));

  dds.forEach((b) =>
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = b.getAttribute('aria-expanded') !== 'true';
      closeDds(b);
      b.setAttribute('aria-expanded', String(open));
    }),
  );
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.dd')) closeDds();
  });

  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      menu.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) { set(false); closeDds(); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      closeDds();
      if (menu.classList.contains('is-open')) { set(false); btn.focus(); }
    });
  }

  // sombra no cabeçalho ao rolar
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .topbar { background: var(--navy); font-size: 13px; color: var(--muted); }
  .topbar__in { padding: 8px 0; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 6px 24px; }
  .topbar__phones { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .topbar a { color: var(--cream); text-decoration: none; }
  .topbar a:hover { color: var(--gold); }
  .topbar__social { display: flex; align-items: center; gap: 16px; }
  .topbar__social a { display: inline-flex; align-items: center; gap: 6px; }

  .nav {
    position: sticky; top: 0; z-index: 60; background: rgba(255, 255, 255, .92);
    -webkit-backdrop-filter: blur(14px) saturate(160%); backdrop-filter: blur(14px) saturate(160%);
    transition: box-shadow .3s;
  }
  .nav.is-scrolled { box-shadow: 0 10px 30px -18px rgba(11, 31, 92, .45); }
  .nav__in { height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  /* o logo tem letras brancas: fica sobre uma placa azul */
  .nav__logo { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 14px; background: var(--royal); flex: none; transition: transform .3s var(--ease); }
  .nav__logo:hover { transform: translateY(-1px); }
  .nav__logo img { height: 40px; width: auto; }

  .nav__list { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 2px; }
  .nav__link {
    position: relative; display: inline-flex; align-items: center; gap: 6px; height: 44px; padding: 0 14px;
    border: 0; border-radius: 999px; background: transparent; color: var(--cream); font: inherit; font-size: 15px; font-weight: 600;
    text-decoration: none; cursor: pointer; transition: color .2s;
  }
  /* sublinhado verde que desliza ao passar o mouse */
  .nav__link::after {
    content: ''; position: absolute; left: 14px; right: 14px; bottom: 6px; height: 2px; border-radius: 2px;
    background: var(--green); transform: scaleX(0); transform-origin: left; transition: transform .35s var(--ease);
  }
  .nav__link:hover, .nav__link[aria-expanded='true'] { color: var(--royal); }
  .nav__link:hover::after, .nav__link[aria-expanded='true']::after, .nav__link.is-active::after { transform: scaleX(1); }
  .nav__link.is-active { color: var(--green); }
  .nav__link :global(.dd__chev) { transition: transform .25s var(--ease); }
  .dd__btn[aria-expanded='true'] :global(.dd__chev) { transform: rotate(180deg); }

  .dd { position: relative; }
  .dd__panel {
    list-style: none; margin: 0; padding: 10px 8px 8px; position: absolute; top: calc(100% + 10px); left: 0; min-width: 300px;
    background: #FFFFFF; border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
    box-shadow: 0 30px 60px -24px rgba(11, 31, 92, .35);
    visibility: hidden; opacity: 0; transform: translateY(-6px) scale(.98); transform-origin: top left;
    transition: opacity .2s, transform .25s var(--ease), visibility 0s .25s;
  }
  .dd__panel::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: linear-gradient(90deg, var(--green) 33%, var(--red) 33% 66%, #1B30A3 66%); }
  .dd__btn[aria-expanded='true'] + .dd__panel { visibility: visible; opacity: 1; transform: none; transition: opacity .2s, transform .25s var(--ease); }
  .dd__item { display: grid; gap: 2px; padding: 12px 14px; border-radius: 12px; text-decoration: none; color: var(--cream); transition: background .15s, transform .2s var(--ease); }
  .dd__item strong { font-size: 15px; }
  .dd__item span { font-size: 13px; color: var(--muted); }
  .dd__item:hover { background: var(--ink2); color: var(--royal); transform: translateX(3px); }
  .dd__item[aria-current='page'] { background: rgba(30, 139, 58, .1); }
  .dd__item[aria-current='page'] strong { color: var(--green); }

  .nav__actions { display: flex; align-items: center; gap: 10px; }
  .nav__cta { height: 48px; padding: 0 22px; font-size: 15px; }
  .nav__toggle, .nav__cta-m { display: none; }

  .tricolor { display: flex; height: 3px; }
  .tricolor span { flex: 1; }
  .tricolor span:nth-child(1) { background: var(--green); }
  .tricolor span:nth-child(2) { background: var(--red); }
  .tricolor span:nth-child(3) { background: #1B30A3; }

  @media (max-width: 1139px) {
    .nav__toggle {
      display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px;
      border: 1px solid var(--line2); background: #FFFFFF; color: var(--royal); cursor: pointer;
    }
    .nav__toggle path { transition: transform .3s var(--ease), opacity .2s; transform-origin: center; }
    .nav__toggle[aria-expanded='true'] .l1 { transform: translateY(5px) rotate(45deg); }
    .nav__toggle[aria-expanded='true'] .l2 { opacity: 0; }
    .nav__toggle[aria-expanded='true'] .l3 { transform: translateY(-5px) rotate(-45deg); }

    .nav__menu {
      position: absolute; left: 0; right: 0; top: 100%; max-height: calc(100dvh - 120px); overflow-y: auto;
      padding: 12px 16px 24px; background: #FFFFFF; border-top: 1px solid var(--line);
      box-shadow: 0 30px 40px -20px rgba(11, 31, 92, .35);
      visibility: hidden; opacity: 0; transform: translateY(-8px);
      transition: opacity .25s, transform .25s var(--ease), visibility 0s .25s;
    }
    .nav__menu.is-open { visibility: visible; opacity: 1; transform: none; transition: opacity .25s, transform .25s var(--ease); }
    .nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav__list > li { border-bottom: 1px solid var(--line); }
    .nav__link { width: 100%; height: 56px; justify-content: space-between; padding: 0 6px; border-radius: 0; font-size: 17px; }
    .nav__link::after { display: none; }
    .dd__panel {
      position: static; min-width: 0; padding: 0 0 10px; border: 0; box-shadow: none; background: transparent;
      display: none; visibility: visible; opacity: 1; transform: none;
    }
    .dd__panel::before { display: none; }
    .dd__btn[aria-expanded='true'] + .dd__panel { display: block; }
    .dd__item { padding: 10px 12px; border-left: 3px solid var(--green); border-radius: 0 12px 12px 0; margin: 4px 0; background: var(--ink2); }
    .nav__cta-m { display: flex; margin-top: 20px; height: 54px; font-size: 16px; }
  }
  @media (max-width: 559px) {
    .nav__cta { display: none; }
    .nav__in { height: 68px; }
    .nav__logo { padding: 6px 10px; }
    .nav__logo img { height: 34px; }
    .topbar__phones > span:nth-child(2) { display: none; }
    .topbar__social span { display: none; }
  }
</style>
