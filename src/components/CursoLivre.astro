---
/**
 * Página de um curso de experiência prática (um dia) da TEC Mais, no modelo do "Guia da Turma":
 * fundo creme, títulos com serifa, rótulos laranja e fotos com moldura deslocada.
 * Dados: src/data/cursos-livres.ts.
 */
import '@fontsource-variable/lora';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import Arrow from './Arrow.astro';
import { school, waLink, formatPhone, formacoes } from '../data/site';
import { cursosLivres, type CursoLivre } from '../data/cursos-livres';

interface Props { c: CursoLivre }
const { c } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tec = formacoes.find((x) => x.slug === 'tec-mais')!;
const wa = waLink(tec.contact.whatsapp, c.whatsappMessage);
const outro = cursosLivres.find((x) => x.slug !== c.slug)!;
const total = c.bonus.reduce((n, b) => n + (b.valor ? Number(b.valor.replace(/\D/g, '')) : 0), 0);
const num = (i: number) => String(i + 1).padStart(2, '0');
let sec = 0;
const n = () => num(sec++);
---

<Base title={`${c.nome} em Valparaíso de Goiás | TEC Mais · ${school.name}`} description={`${c.nome} na TEC Mais: um dia de teoria e prática, apostila, lanche, mimo e acesso à plataforma exclusiva TEC Mais Academy.${c.preco.valor ? ` ${c.preco.selo ?? 'Por'} ${c.preco.valor}.` : ''}`}>
  <Header />
  <main id="conteudo" class="cl">

    <!-- capa -->
    <section class="cl-hero">
      <div class="wrap cl-hero__g">
        <div>
          <nav aria-label="Você está em" class="mono cl-crumb"><a href={`${base}/`}>Início</a> / <a href={`${base}/tec-mais`}>TEC Mais</a> / <span aria-current="page">{c.nomeCurto}</span></nav>
          <p class="cl-k">{c.kicker}</p>
          <h1 class="cl-h1">{c.nome}</h1>
          <p class="cl-promise">{c.titulo} <em>{c.acento}</em></p>
          <p class="cl-lead">{c.lead}</p>
          {c.preco.valor && (
            <div class="cl-price">
              <span class="cl-price__sel">{c.preco.selo}</span>
              <span class="cl-price__v">por apenas <strong>{c.preco.valor}</strong></span>
              {c.preco.ancora && <span class="cl-price__a">{c.preco.ancora}</span>}
            </div>
          )}
          <div class="cl-ctas">
            <a href={wa} target="_blank" rel="noopener" class="cl-btn" data-wa>{c.preco.valor ? `Garantir minha vaga por ${c.preco.valor}` : 'Quero minha vaga'}<span class="cl-btn__a"><Arrow /></span></a>
            <a href="#plataforma" class="cl-ghost">Ver a plataforma</a>
          </div>
        </div>
        <figure class="cl-frame cl-frame--hero">
          <img src={`${base}${c.fotoHero.src}`} alt={c.fotoHero.alt} decoding="async" fetchpriority="high" />
        </figure>
      </div>
      <div class="wrap cl-strip">
        <div><span class="cl-strip__k">Turma</span><strong>{c.turma.data ?? 'Próxima turma: data pelo WhatsApp'}</strong></div>
        <div><span class="cl-strip__k">Horário</span><strong>08h00 — 17h30</strong></div>
        <div><span class="cl-strip__k">Programação</span><strong>{c.turma.carga}</strong></div>
        <div><span class="cl-strip__k">Depois da aula</span><strong>Acesso à TEC Mais Academy</strong></div>
      </div>
    </section>

    <!-- o que você ganha -->
    <section class="cl-s">
      <div class="wrap">
        <p class="cl-k">{n()} — O que você ganha</p>
        <h2 class="cl-h2">Não é só uma aula. <em>É um pacote completo.</em></h2>
        <ul class="cl-gain">
          <li><b>Aula teórica</b><span>08h00 às 12h00</span></li>
          <li><b>Aula prática</b><span>13h30 às 17h30</span></li>
          {c.incluso.filter((x) => x.icone !== 'monitor').map((x) => <li><b>{x.titulo.replace(' completo', '').replace(' durante o intervalo', '')}</b><span>{x.icone === 'book' ? 'para levar' : x.icone === 'tool' ? 'sem custo adicional' : x.icone === 'heart' ? 'no intervalo' : 'no encerramento'}</span></li>)}
          <li class="cl-gain--hl"><b>Plataforma exclusiva</b><span>{c.bonus.length} bônus{total ? ` · valem R$ ${total}` : ''}</span></li>
        </ul>
      </div>
    </section>

    <!-- programação -->
    <section class="cl-s cl-s--soft">
      <div class="wrap cl-two">
        <div>
          <p class="cl-k">{n()} — Programação do dia</p>
          <h2 class="cl-h2">Seu dia, <em>do começo ao fim.</em></h2>
          <p class="cl-p">Para você chegar já sabendo como será a experiência, organizamos a programação em etapas.</p>
          <p class="cl-big"><strong>9h30</strong><span>de programação,<br />do início ao encerramento</span></p>
        </div>
        <ol class="cl-tl">
          {c.programacao.map((p) => (
            <li>
              <span class="cl-tl__t">{p.inicio}{p.fim && <><br />{p.fim}</>}</span>
              <div><h3>{p.titulo}</h3><p>{p.texto}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- conteúdo -->
    <section class="cl-s">
      <div class="wrap">
        <p class="cl-k">{n()} — O que você vai aprender</p>
        <h2 class="cl-h2">O conteúdo ganha sentido <em>quando você entende onde ele será aplicado.</em></h2>
        <div class="cl-topics">
          {c.conteudo.map((t, i) => (
            <article><span>{num(i)}</span><h3>{t.titulo}</h3><p>{t.texto}</p></article>
          ))}
        </div>
        {c.destaqueConteudo && <div class="cl-band"><span>{c.destaqueConteudo.label}</span><strong>{c.destaqueConteudo.valor}</strong></div>}
      </div>
    </section>

    <!-- incluso -->
    <section class="cl-s cl-s--soft">
      <div class="wrap">
        <p class="cl-k">{n()} — O que está incluso</p>
        <h2 class="cl-h2">Além do conteúdo, <em>cuidamos de cada detalhe do seu dia.</em></h2>
        <p class="cl-p">Sua inscrição garante tudo isso, e o aprendizado continua depois que a aula acaba.</p>
        <div class="cl-inc">
          {c.incluso.map((x) => (
            <article class={x.icone === 'monitor' ? 'cl-inc--hl' : ''}>
              <span class="cl-inc__i"><Icon name={x.icone} size={22} /></span>
              <h3>{x.titulo}</h3><p>{x.texto}</p>
              {x.icone === 'monitor' && <a href="#plataforma">Conhecer a plataforma →</a>}
            </article>
          ))}
        </div>
        <blockquote class="cl-quote">“{c.frase}”</blockquote>
      </div>
    </section>

    <!-- plataforma -->
    <section id="plataforma" class="cl-s cl-plat">
      <div class="cl-plat__glow" aria-hidden="true"></div>
      <div class="wrap">
        <p class="cl-k cl-k--l">{n()} — Plataforma exclusiva</p>
        <h2 class="cl-h2">A aula acaba às 17h30. <em>Na TEC Mais Academy, ela continua.</em></h2>
        <p class="cl-p">{c.bonusIntro}</p>
        <ul class="cl-plat__feats">
          <li><Icon name="check" size={16} />Login individual, só seu</li>
          <li><Icon name="check" size={16} />Funciona no celular</li>
          <li><Icon name="check" size={16} />Progresso salvo, aula por aula</li>
          <li><Icon name="check" size={16} />Ferramentas para usar na prática</li>
        </ul>
        <div class="cl-shots">
          <figure class="cl-shot">
            <div class="cl-shot__bar"><i></i><i></i><i></i><span>tecmais academy</span></div>
            <img src={`${base}${c.telas[0].src}`} alt={c.telas[0].alt} loading="lazy" decoding="async" width="1440" height="900" />
            <figcaption>{c.telas[0].legenda}</figcaption>
          </figure>
          <div class="cl-phones">
            {c.telasCelular.map((t) => <figure class="cl-phone"><img src={`${base}${t.src}`} alt={t.alt} loading="lazy" decoding="async" width="665" height="1440" /></figure>)}
          </div>
        </div>
        <div class="cl-bonus">
          {c.bonus.map((b, i) => (
            <article>
              <header><span class="cl-bonus__n">Bônus {num(i)}</span>{b.valor && <span class="cl-bonus__v">Vale <s>{b.valor}</s></span>}</header>
              <h3>{b.titulo}</h3>
              <p>{b.texto}</p>
              <small><Icon name="clock" size={14} />{b.libera}</small>
            </article>
          ))}
        </div>
        {c.telas[1] && (
          <figure class="cl-shot cl-shot--2">
            <div class="cl-shot__bar"><i></i><i></i><i></i><span>tecmais academy</span></div>
            <img src={`${base}${c.telas[1].src}`} alt={c.telas[1].alt} loading="lazy" decoding="async" width="1440" height="900" />
            <figcaption>{c.telas[1].legenda}</figcaption>
          </figure>
        )}
      </div>
    </section>

    <!-- prática -->
    <section class="cl-s">
      <div class="wrap">
        <p class="cl-k">{n()} — Parte prática</p>
        <h2 class="cl-h2">Depois de entender, <em>vem a prática.</em></h2>
        <p class="cl-p">{c.pratica.intro}</p>
        <div class="cl-note"><strong>Prática supervisionada</strong>{c.pratica.nota}</div>
        <div class="cl-mats">
          {c.pratica.grupos.map((g) => (
            <div><h3>{g.titulo}</h3><ul>{g.itens.map((x) => <li>{x}</li>)}</ul></div>
          ))}
        </div>
        <ol class="cl-steps">{c.etapas.map((e, i) => <li><span>{num(i)}</span>{e}</li>)}</ol>
        <div class={`cl-gal cl-gal--${c.pratica.fotos.length}`}>
          {c.pratica.fotos.map((f, i) => <figure class={`cl-frame${i % 2 ? ' cl-frame--alt' : ''}`}><img src={`${base}${f.src}`} alt={f.alt} loading="lazy" decoding="async" /></figure>)}
        </div>
        {c.pratica.fotosNota && <p class="cl-gal__n">{c.pratica.fotosNota}</p>}
      </div>
    </section>

    <!-- quem conduz -->
    {c.professor && (
      <section class="cl-s cl-s--soft">
        <div class="wrap cl-prof">
          <div>
            <p class="cl-k">{n()} — Quem conduz a turma</p>
            <h2 class="cl-h2 cl-prof__n">{c.professor.nome}</h2>
            <p class="cl-prof__c">{c.professor.cargo}</p>
            <h3 class="cl-prof__f">Formação</h3>
            <ul>{c.professor.formacao.map((x) => <li>{x}</li>)}</ul>
            {c.professor.fotoAula && <figure class="cl-frame cl-frame--sm"><img src={`${base}${c.professor.fotoAula}`} alt={`${c.professor.nome} em sala de aula`} loading="lazy" decoding="async" /></figure>}
          </div>
          <img class="cl-prof__img" src={`${base}${c.professor.foto}`} alt={c.professor.nome} loading="lazy" decoding="async" />
        </div>
      </section>
    )}

    <!-- investimento -->
    <section class="cl-s" id="investimento">
      <div class="wrap">
        <div class="cl-inv">
          <div>
            <p class="cl-k">{n()} — Investimento</p>
            {c.preco.valor ? (
              <>
                <h2 class="cl-h2">{c.preco.selo ?? 'Investimento'}: <em>{c.preco.valor}.</em></h2>
                <p class="cl-p">{c.preco.nota}</p>
              </>
            ) : (
              <>
                <h2 class="cl-h2">Tudo isso <em>numa única inscrição.</em></h2>
                <p class="cl-p">{c.preco.nota}</p>
              </>
            )}
          </div>
          <div class="cl-inv__box">
            <ul>
              <li><span>Aula teórica + aula prática</span><b>9h30</b></li>
              <li><span>Apostila, lanche e mimo da turma</span><b>incluso</b></li>
              {c.bonus.map((b) => <li><span>{b.titulo}</span><b>{b.valor ? <s>{b.valor}</s> : 'incluso'}</b></li>)}
            </ul>
            {c.preco.valor ? (
              <p class="cl-inv__t"><span>{total ? <>De <s>R$ {total}</s> só em bônus, por</> : 'Por'}</span><strong>{c.preco.valor}</strong>{c.preco.legenda && <small>{c.preco.legenda}</small>}</p>
            ) : (
              <p class="cl-inv__t"><span>Valores e formas de pagamento</span><strong class="cl-inv__ask">pelo WhatsApp</strong></p>
            )}
            <a href={wa} target="_blank" rel="noopener" class="cl-btn cl-btn--full" data-wa>{c.preco.valor ? `Garantir minha vaga por ${c.preco.valor}` : 'Consultar valor e próxima turma'}<span class="cl-btn__a"><Icon name="whatsapp" size={20} /></span></a>
            <p class="cl-inv__w">Atendimento humano no WhatsApp {formatPhone(tec.contact.whatsapp.slice(2))}.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- antes de ir -->
    <section class="cl-s cl-s--soft">
      <div class="wrap cl-two">
        <div>
          <p class="cl-k">{n()} — Orientações</p>
          <h2 class="cl-h2">Antes de sair de casa, <em>confira.</em></h2>
          <dl class="cl-dl">
            <div><dt>Data</dt><dd>{c.turma.data ?? 'Confirmada no WhatsApp ao garantir a vaga'}</dd></div>
            <div><dt>Horário</dt><dd>{c.turma.horario}</dd></div>
            <div><dt>Intervalo</dt><dd>{c.turma.intervalo}</dd></div>
            <div><dt>Local</dt><dd>{c.turma.local}</dd></div>
            <div><dt>Prática</dt><dd>{c.pratica.nota.replace(/\.$/, '')}</dd></div>
            <div><dt>Você recebe</dt><dd>Apostila, lanche, mimo especial e acesso à TEC Mais Academy</dd></div>
          </dl>
        </div>
        <div class="cl-addr">
          <a class="cl-map" href={tec.contact.mapsUrl ?? '#'} target="_blank" rel="noopener" aria-label="Abrir a localização da TEC Mais no Google Maps"><img src={`${base}/img/cursos/mapa-tecmais.webp`} alt="Mapa com a localização da TEC Mais no Jardim Céu Azul, Valparaíso de Goiás" loading="lazy" decoding="async" /></a>
          <p><strong>TEC Mais Cursos Técnicos</strong>Quadra 122 — Jardim Céu Azul<br />Valparaíso de Goiás — GO · CEP 72871-075</p>
          {tec.contact.mapsUrl && <a href={tec.contact.mapsUrl} target="_blank" rel="noopener">Como chegar →</a>}
        </div>
      </div>
    </section>

    <!-- dúvidas -->
    <section class="cl-s">
      <div class="wrap cl-two">
        <div>
          <p class="cl-k">{n()} — Dúvidas</p>
          <h2 class="cl-h2">Antes de você perguntar, <em>a gente responde.</em></h2>
          <a href={wa} target="_blank" rel="noopener" class="cl-ghost cl-ghost--d" data-wa><Icon name="whatsapp" size={18} />Falar com a equipe</a>
        </div>
        <div class="cl-faq">
          {c.faq.map((f, i) => <details open={i === 0}><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>

    <!-- fechamento -->
    <section class="cl-end">
      <div class="wrap">
        <p class="cl-k">TEC Mais · {c.nomeCurto}</p>
        <h2>{c.finalTitulo}</h2>
        <p>{c.finalTexto}</p>
        <p class="cl-end__h">08h00 — 17h30</p>
        <a href={wa} target="_blank" rel="noopener" class="cl-btn" data-wa>{c.preco.valor ? `Garantir minha vaga por ${c.preco.valor}` : 'Quero minha vaga'}<span class="cl-btn__a"><Arrow /></span></a>
        <p class="cl-end__o">Também tem: <a href={`${base}/tec-mais/${outro.slug}`}>{outro.nome}</a></p>
        <img src={`${base}${tec.logo.src}`} alt="TEC Mais Cursos Técnicos" width={tec.logo.w} height={tec.logo.h} loading="lazy" />
        <small>TEC Mais Cursos Técnicos · 25 anos de formação profissional · +30 escolas</small>
      </div>
    </section>

  </main>
  <Footer cta={false} wa={wa} waLabel="Falar com a TEC Mais" />
</Base>

<script>
  // UTMs na mensagem e evento de lead nos botões de WhatsApp
  document.querySelectorAll<HTMLAnchorElement>('.cl [data-wa]').forEach((a) =>
    a.addEventListener('click', () => {
      const W = window as unknown as { exitoWa?: (u: string) => string; exitoTrack?: (n: string, p?: object) => void };
      if (W.exitoWa) a.href = W.exitoWa(a.href);
      W.exitoTrack?.('generate_lead', { form: 'curso_livre', page: location.pathname });
    }),
  );
</script>

<style>
  .cl { --cream: #F7F3EE; --cream2: #EFE7DC; --beige: #E6D9C8; --ink: #0D1240; --mu: #5B6188; --or: #E0551A; --or2: #F06022; --navy: #1A1A8C; --serif: 'Lora Variable', Georgia, serif; background: var(--cream); color: var(--ink); }
  .cl em { font-style: italic; color: var(--or); font-weight: 500; }
  .cl-k { margin: 0 0 14px; display: flex; align-items: center; gap: 10px; font-family: var(--f-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--or); }
  .cl-k::before { content: ""; width: 26px; height: 2px; background: var(--or); }
  .cl-k--l { color: #FF9A5C; } .cl-k--l::before { background: #FF9A5C; }
  .cl-h2 { margin: 0; font-family: var(--serif); font-weight: 600; font-size: clamp(28px, 3.6vw, 46px); line-height: 1.12; letter-spacing: -.015em; max-width: 24ch; text-wrap: balance; }
  .cl-p { margin: 14px 0 0; max-width: 60ch; font-size: 17px; line-height: 1.6; color: var(--mu); }
  .cl-s { padding: clamp(70px, 8vw, 110px) 0; }
  .cl-s--soft { background: #FFFFFF; }
  .cl-two { display: grid; grid-template-columns: .9fr 1.1fr; gap: 56px; align-items: start; }

  .cl-btn { display: inline-flex; align-items: center; gap: 14px; height: 60px; padding: 0 8px 0 26px; border-radius: 999px; background: linear-gradient(180deg, var(--or2), var(--or)); color: #fff; font-weight: 800; font-size: 17px; text-decoration: none; box-shadow: 0 16px 34px -14px rgba(224, 85, 26, .8); transition: transform .3s var(--ease); }
  .cl-btn:hover { color: #fff; transform: translateY(-2px); }
  .cl-btn__a { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: #fff; }
  .cl-btn--full { width: 100%; justify-content: space-between; }
  .cl-ghost { display: inline-flex; align-items: center; gap: 8px; height: 60px; padding: 0 24px; border-radius: 999px; border: 1.5px solid var(--ink); color: var(--ink); font-weight: 700; text-decoration: none; transition: .25s; }
  .cl-ghost:hover { background: var(--ink); color: #fff; }
  .cl-ghost--d { margin-top: 24px; }

  /* capa */
  .cl-hero { padding: 40px 0 0; background: radial-gradient(50% 60% at 100% 0%, rgba(240, 96, 34, .1), transparent 70%), var(--cream); }
  .cl-hero__g { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; }
  .cl-crumb { font-size: 12px; color: var(--mu); margin-bottom: 26px; } .cl-crumb a { color: var(--ink); }
  .cl-h1 { margin: 0; font-family: var(--f-disp); font-size: clamp(38px, 5.2vw, 68px); font-weight: 800; letter-spacing: -.04em; line-height: 1; color: var(--ink); text-wrap: balance; }
  .cl-promise { margin: 18px 0 0; font-family: var(--serif); font-size: clamp(20px, 2vw, 26px); line-height: 1.35; max-width: 30ch; }
  .cl-lead { margin: 16px 0 0; max-width: 56ch; font-size: 17px; line-height: 1.6; color: var(--mu); }
  .cl-price { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 24px; padding: 14px 18px; border-radius: 18px; background: #fff; border: 1px solid var(--beige); box-shadow: 0 20px 40px -30px rgba(13, 18, 64, .4); }
  .cl-price__sel { padding: 6px 12px; border-radius: 999px; background: var(--ink); color: #FFE45C; font-family: var(--f-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
  .cl-price__v { font-size: 16px; } .cl-price__v strong { font-family: var(--serif); font-size: 34px; color: var(--or); margin-left: 4px; }
  .cl-price__a { flex-basis: 100%; font-size: 13.5px; color: var(--mu); }
  .cl-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .cl-frame { position: relative; margin: 0; }
  .cl-frame::before { content: ""; position: absolute; inset: 14px -14px -14px 14px; border: 2px solid var(--navy); border-radius: 4px; z-index: 0; }
  .cl-frame::after { content: ""; position: absolute; left: -8px; top: -8px; width: 60%; height: 8px; background: var(--or2); z-index: 2; }
  .cl-frame img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; border-radius: 4px; display: block; }
  .cl-frame--alt::before { inset: -14px 14px 14px -14px; border-color: var(--or2); }
  .cl-frame--alt::after { left: auto; right: -8px; top: auto; bottom: -8px; background: var(--navy); }
  .cl-frame--hero img { aspect-ratio: 4/3; }
  .cl-strip { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 64px; border-top: 1px solid var(--beige); }
  .cl-strip > div { padding: 22px 18px 26px 0; display: grid; gap: 4px; }
  .cl-strip > div + div { padding-left: 18px; border-left: 1px solid var(--beige); }
  .cl-strip__k { font-family: var(--f-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--or); }
  .cl-strip strong { font-family: var(--serif); font-size: 18px; font-weight: 600; }

  /* ganhos */
  .cl-gain { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; }
