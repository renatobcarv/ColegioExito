---
import { steps } from '../data/site';
---

<section id="acompanhamento" class="acomp dark" aria-labelledby="acomp-t">
  <div class="wrap acomp__grid">
    <div class="rv">
      <div class="kicker">Como funciona</div>
      <h2 id="acomp-t" class="disp h2" style="font-size:clamp(36px,4.6vw,64px)">Você não descobre no boletim. <span class="serif">Você acompanha.</span></h2>
      <ol class="steps tri" id="steps">
        {
          steps.map((s, i) => (
            <li class={`step${i === 0 ? ' on' : ''}`}>
              <span class="n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <b class="disp">{s.title}</b>
                <small>{s.text}</small>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="rv portal" aria-hidden="true">
      <div class="portal__bar">
        <i style="background:var(--red)"></i><i></i><i></i>
        <span class="mono">Conexão Êxito · área do responsável</span>
      </div>
      <div class="portal__body">
        <div class="portal__head">
          <div>
            <div class="disp portal__name">Pedro Henrique</div>
            <div class="mono portal__sub">7º ano B · Unidade II</div>
          </div>
          <span class="mono portal__badge">frequência 97%</span>
        </div>
        <div class="portal__kpis">
          <div><div class="mono">MÉDIA</div><div class="disp">8,6</div></div>
          <div><div class="mono">REFORÇO</div><div class="disp">1</div></div>
          <div><div class="mono">RECADOS</div><div class="disp" style="color:var(--gold)">2</div></div>
        </div>
        <div class="portal__chart">
          {[48, 55, 52, 66, 74, 86].map((h, i) => <i style={`height:${h}%;background:${i === 5 ? 'var(--red)' : i > 2 ? '#3E6FD8' : '#4A6AD0'}`}></i>)}
        </div>
        <div class="mono portal__foot">evolução por mês · imagem ilustrativa</div>
      </div>
    </div>
  </div>
</section>

<script>
  // percorre os 4 passos quando a seção está visível
  const list = document.getElementById('steps');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (list && !reduce) {
    const items = [...list.children] as HTMLElement[];
    let i = 0;
    let timer: number | undefined;
    const go = (n: number) => {
      items.forEach((el, k) => el.classList.toggle('on', k === n));
      i = n;
    };
    const start = () => { timer ??= window.setInterval(() => go((i + 1) % items.length), 2600); };
    const stop = () => { window.clearInterval(timer); timer = undefined; };
    items.forEach((el, k) => el.addEventListener('mouseenter', () => { stop(); go(k); }));
    list.addEventListener('mouseleave', start);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.4 }).observe(list);
  }
</script>

<style>
  .acomp { padding: clamp(90px, 10vw, 140px) 0; background: var(--royal); }
  .acomp__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 56px; align-items: center; }

  .steps { list-style: none; padding: 0; display: grid; gap: 6px; margin: 36px 0 0; }
  .step { display: grid; grid-template-columns: 44px 1fr; gap: 16px; align-items: center; padding: 16px 18px; border-radius: 18px; border: 1px solid transparent; transition: background .4s, border-color .4s; }
  .step .n { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-size: 13px; background: var(--ink3); color: var(--muted); transition: background .4s, color .4s; }
  .step b { display: block; font-size: 19px; font-weight: 650; letter-spacing: -.015em; }
  .step small { color: var(--muted); font-size: 14.5px; }
  .step.on { background: var(--ink3); border-color: var(--line2); }
  .step.on .n { background: var(--c); color: #FFFFFF; }
  .step .n { box-shadow: inset 0 0 0 2px var(--c); }

  .portal { border-radius: 22px; background: var(--navy); border: 1px solid var(--line2); box-shadow: 0 40px 100px -30px rgba(0, 0, 0, .7); overflow: hidden; }
  .portal__bar { display: flex; align-items: center; gap: 6px; padding: 12px 14px; border-bottom: 1px solid var(--line); background: #0A2272; }
  .portal__bar i { width: 10px; height: 10px; border-radius: 50%; background: #4A6AD0; }
  .portal__bar span { margin-left: 12px; font-size: 11.5px; color: var(--muted); }
  .portal__body { padding: 26px; display: grid; gap: 18px; }
  .portal__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .portal__name { font-size: 24px; font-weight: 720; letter-spacing: -.025em; }
  .portal__sub { font-size: 11.5px; color: var(--muted); margin-top: 4px; }
  .portal__badge { font-size: 11px; padding: 6px 10px; border-radius: 999px; background: rgba(95, 211, 138, .12); border: 1px solid rgba(95, 211, 138, .35); color: #5FD38A; }
  .portal__kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .portal__kpis > div { padding: 14px; border-radius: 14px; background: var(--ink3); }
  .portal__kpis .mono { font-size: 10px; color: var(--dim); }
  .portal__kpis .disp { font-size: 28px; font-weight: 760; }
  .portal__chart { display: flex; align-items: flex-end; gap: 8px; height: 120px; padding: 12px 14px 0; border-radius: 14px; background: var(--ink3); }
  .portal__chart i { flex: 1; border-radius: 4px 4px 0 0; }
  .portal__foot { font-size: 11px; color: var(--dim); }
</style>
