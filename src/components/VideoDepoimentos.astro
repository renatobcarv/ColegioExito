---
import { videoTestimonials, school, waLink } from '../data/site';
import Icon from './Icon.astro';
---

{
  videoTestimonials.length > 0 && (
    <section id="depoimentos" class="vdep" data-accent="red" aria-labelledby="vdep-t">
      <div class="wrap">
        <div class="vdep__head rv">
          <div>
            <div class="kicker">Quem estuda aqui</div>
            <h2 id="vdep-t" class="disp h2">Quem vive o Êxito <span class="serif">conta como é.</span></h2>
          </div>
          <p class="lead">Não acredite só na gente. Ouça os alunos que estudam no Êxito todos os dias e sabem como é ser acompanhado de perto.</p>
        </div>

        <ul class={`vdep__grid stagger tri vdep__grid--${Math.min(videoTestimonials.length, 3)}`}>
          {videoTestimonials.map((v, i) => (
            <li class="vcard rv">
              <div class="vcard__frame">
                <button type="button" class="vcard__play" data-yt={v.id} aria-label={`Assistir depoimento ${v.name ? `de ${v.name}` : `do aluno ${i + 1}`}`}>
                  <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
                  <span class="vcard__shade" aria-hidden="true"></span>
                  <span class="vcard__btn" aria-hidden="true"><Icon name="play" size={26} /></span>
                  <span class="mono vcard__tag" aria-hidden="true">ALUNO ÊXITO</span>
                </button>
              </div>
              <div class="vcard__cap">
                {v.quote && <p class="disp vcard__q">“{v.quote}”</p>}
                <strong>{v.name ?? 'Aluno Êxito'}</strong>
                {v.role && <span>{v.role}</span>}
              </div>
            </li>
          ))}
        </ul>

        <div class="vdep__cta rv">
          <a href={waLink(school.whatsapp)} target="_blank" rel="noopener" class="btn">Quero isso para o meu filho<span class="arr"><Icon name="arrow" /></span></a>
        </div>
      </div>
    </section>
  )
}

<script>
  // Carrega o player do YouTube só no clique (página leve e sem cookies antes do play)
  document.querySelectorAll<HTMLButtonElement>('.vcard__play').forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.yt;
      if (!id) return;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&playsinline=1&rel=0&modestbranding=1`;
      f.title = b.getAttribute('aria-label') ?? 'Depoimento em vídeo';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.className = 'vcard__iframe';
      b.replaceWith(f);
      f.focus();
    }),
  );
</script>

<style>
  .vdep { padding: clamp(80px, 10vw, 130px) 0; background: linear-gradient(180deg, #FFFFFF, var(--ink2)); }
  .vdep__head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 56px; align-items: end; margin-bottom: 52px; }
  .vdep__head .lead { margin: 0; max-width: 480px; }

  .vdep__grid { list-style: none; margin: 0 auto; padding: 0; display: grid; gap: 22px; justify-content: center; }
  .vdep__grid--1 { grid-template-columns: minmax(0, 340px); }
  .vdep__grid--2 { grid-template-columns: repeat(2, minmax(0, 340px)); }
  .vdep__grid--3 { grid-template-columns: repeat(3, minmax(0, 340px)); }

  .vcard { display: grid; gap: 16px; }
  .vcard__frame {
    position: relative; aspect-ratio: 9 / 16; border-radius: 28px; overflow: hidden; background: linear-gradient(160deg, #2B55D1, var(--royal-deep));
    border-top: 5px solid var(--c); box-shadow: 0 40px 80px -46px rgba(11, 31, 92, .7);
  }
  .vcard__play { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; cursor: pointer; background: transparent; }
  .vcard__play img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 1s var(--ease); }
  .vcard__play:hover img { scale: 1.05; }
  .vcard__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5, 12, 35, 0) 40%, rgba(5, 12, 35, .65)); }
  .vcard__btn {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center;
    background: var(--c); color: #FFFFFF; box-shadow: 0 0 0 10px color-mix(in srgb, var(--c) 30%, transparent), 0 20px 40px -10px rgba(0, 0, 0, .5);
    transition: transform .35s var(--ease);
  }
  .vcard__btn :global(svg) { margin-left: 4px; }
  .vcard__play:hover .vcard__btn { transform: scale(1.08); }
  .vcard__tag { position: absolute; left: 16px; bottom: 16px; padding: 6px 10px; border-radius: 8px; background: rgba(255, 255, 255, .16); color: #FFFFFF; font-size: 11px; letter-spacing: .12em; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .vcard__frame :global(.vcard__iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .vcard__cap { display: grid; gap: 2px; padding: 0 4px; }
  .vcard__q { margin: 0 0 8px; font-size: 19px; font-weight: 650; line-height: 1.3; letter-spacing: -.015em; }
  .vcard__cap strong { font-size: 16px; }
  .vcard__cap span { font-size: 14px; color: var(--muted); }

  .vdep__cta { display: flex; justify-content: center; margin-top: 48px; }

  @media (max-width: 899px) {
    .vdep__head { grid-template-columns: 1fr; }
    .vdep__grid--3 { grid-template-columns: repeat(2, minmax(0, 340px)); }
  }
  @media (max-width: 599px) {
    .vdep__grid--2, .vdep__grid--3 { grid-template-columns: minmax(0, 340px); }
    .vdep__cta .btn { width: 100%; justify-content: space-between; }
  }
</style>
