---
import { formacoes } from '../data/site';
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="formacao" class="form" aria-labelledby="form-t">
  <div class="wrap">
    <div class="form__head rv">
      <div>
        <div class="kicker form__kicker">Formação profissional</div>
        <h2 id="form-t" class="disp h2">Depois da escola, <span class="serif form__serif">uma profissão</span> esperando seu filho.</h2>
      </div>
      <p class="lead form__lead">
        A jornada no Êxito não termina no Ensino Médio. Faculdade com bolsa e cursos de saúde e segurança, perto de casa,
        com a mesma seriedade de sempre.
      </p>
    </div>

    <div class="form__grid stagger">
      {
        formacoes.map((f) => {
          const t = f.theme;
          return (
            <a
              href={`${base}/${f.slug}`}
              class={`fcard rv fcard--${f.slug}`}
              style={`--p:${t.primary};--pd:${t.primaryDark};--pdeep:${t.primaryDeep};--a:${t.accent};--ab:${t.accentBtn}`}
            >
              <div class="fcard__top">
                <span class={`fcard__logo fcard__logo--${f.slug}`}>
                  <img src={`${base}${f.logo.src}`} alt={f.logo.alt} width={f.logo.w} height={f.logo.h} loading="lazy" decoding="async" />
                </span>
                {f.badge && <span class="fcard__badge">{f.badge}</span>}
              </div>
              <span class="mono fcard__kind">{f.kind.toUpperCase()}</span>
              <h3 class="disp">{f.name}</h3>
              <p>{f.pitch}</p>
              {f.areas.length > 0 && (
                <ul class="fcard__areas">
                  {f.areas.slice(0, 4).map((a) => <li>{a.title}</li>)}
                </ul>
              )}
              <span class="fcard__more">{f.slug === 'unopar' ? 'Consultar bolsa e cursos' : 'Conhecer os cursos'} <Icon name="arrow" size={18} /></span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .form { position: relative; padding: clamp(80px, 10vw, 130px) 0; background: linear-gradient(180deg, #F2FAF4, #FFFFFF 70%); overflow: hidden; }
  .form::before {
    content: ''; position: absolute; width: 640px; height: 640px; left: -240px; top: -200px; border-radius: 50%;
    background: radial-gradient(circle, rgba(30, 139, 58, .14), transparent 62%); pointer-events: none;
  }
  .form__head { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px 56px; align-items: end; margin-bottom: 52px; }
  .form__kicker { color: #17722F; }
  .form__serif { color: var(--green); }
  .form__lead { margin: 0; }

  .form__grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .fcard {
    position: relative; display: flex; flex-direction: column; gap: 10px; padding: 32px; border-radius: 26px; text-decoration: none;
    color: #FFFFFF; background: linear-gradient(155deg, var(--pd), var(--pdeep)); overflow: hidden;
    box-shadow: 0 30px 60px -36px rgba(0, 0, 0, .55);
    transition: transform .5s var(--ease), box-shadow .5s var(--ease);
  }
  .fcard::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 5px; background: var(--a); }
  .fcard::after {
    content: ''; position: absolute; inset: auto -30% -55% auto; width: 380px; height: 380px; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--a) 40%, transparent), transparent 65%); transition: transform .7s var(--ease);
  }
  .fcard:hover { transform: translateY(-6px); box-shadow: 0 44px 80px -40px rgba(0, 0, 0, .65); color: #FFFFFF; }
  .fcard:hover::after { transform: scale(1.35); }

  .fcard__top { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
  .fcard__logo {
    display: inline-flex; align-items: center; justify-content: center; height: 86px; padding: 10px 16px;
    border-radius: 18px; background: #FFFFFF; box-shadow: 0 14px 30px -16px rgba(0, 0, 0, .5); transition: transform .4s var(--ease);
  }
  .fcard:hover .fcard__logo { transform: translateY(-2px) rotate(-1deg); }
  .fcard__logo img { height: 100%; width: auto; max-width: 230px; object-fit: contain; }
  .fcard__logo--tec-mais { padding: 16px 18px; }
  .fcard__badge { padding: 8px 14px; border-radius: 999px; background: var(--a); color: #FFFFFF; font-weight: 800; font-size: 13px; text-shadow: 0 1px 1px rgba(0, 0, 0, .2); }
  .fcard__kind { position: relative; z-index: 1; font-size: 11.5px; letter-spacing: .14em; color: var(--a); }
  .fcard h3 { position: relative; z-index: 1; margin: 0; font-size: clamp(28px, 3vw, 38px); font-weight: 760; letter-spacing: -.03em; }
  .fcard p { position: relative; z-index: 1; margin: 0; font-size: 16.5px; line-height: 1.55; color: rgba(255, 255, 255, .85); max-width: 480px; }
  .fcard__areas { position: relative; z-index: 1; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 0; padding: 0; }
  .fcard__areas li { padding: 6px 12px; border-radius: 999px; font-size: 13px; background: rgba(255, 255, 255, .12); border: 1px solid rgba(255, 255, 255, .22); }
  .fcard__more {
    position: relative; z-index: 1; margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 10px;
    margin-top: 24px; height: 50px; padding: 0 20px; border-radius: 999px; background: linear-gradient(180deg, var(--a), var(--ab));
    font-weight: 800; text-shadow: 0 1px 1px rgba(0, 0, 0, .2);
  }
  .fcard__more :global(svg) { transition: transform .35s var(--ease); }
  .fcard:hover .fcard__more :global(svg) { transform: translateX(5px); }

  @media (max-width: 899px) {
    .form__head, .form__grid { grid-template-columns: 1fr; }
    .fcard { padding: 26px 22px; }
  }
</style>
