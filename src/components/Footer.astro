---
import { school, units, formatPhone, telLink, waLink } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { label: 'Instagram', href: school.social.instagram },
  { label: 'Facebook', href: school.social.facebook },
  { label: 'Conexão Êxito', href: school.services.conexao },
  { label: 'Webmail', href: school.services.webmail },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<footer class="foot">
  <div class="wrap foot__grid">
    <div>
      <img src={`${base}/img/logo-quadrado.jpg`} alt={`Logo ${school.name}`} width="120" height="120" loading="lazy" class="foot__logo" />
      <em>{school.slogan}</em><br />Educação Infantil ao Ensino Médio
    </div>
    {
      units.map((u) => (
        <div>
          <strong>{u.tag}</strong><br />
          {u.address.map((l) => <>{l}<br /></>)}
          <a href={telLink(u.phones[0].number)}>{formatPhone(u.phones[0].number)}</a>
          {u.whatsapp && <><br /><a href={waLink(u.whatsapp)} target="_blank" rel="noopener">WhatsApp {formatPhone(u.whatsapp.slice(2))}</a></>}
        </div>
      ))
    }
    <nav aria-label="Redes e serviços" class="foot__links">
      {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </nav>
  </div>
  <div class="wrap foot__legal">
    © {new Date().getFullYear()} {school.name}. Todos os direitos reservados.
  </div>
</footer>

<a href={waLink(school.whatsapp)} target="_blank" rel="noopener" class="wa" aria-label="Falar com o Colégio Êxito no WhatsApp">
  <svg aria-hidden="true" width="30" height="30" viewBox="0 0 24 24" fill="#FFFFFF"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.6-.1 1.2z"></path></svg>
</a>

<style>
  .foot { border-top: 1px solid var(--line); }
  .foot__grid { padding: 48px 0 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 28px; font-size: 14px; line-height: 1.7; color: var(--muted); }
  .foot strong { color: var(--cream); }
  .foot__logo { width: 120px; height: 120px; border-radius: 16px; object-fit: cover; margin-bottom: 12px; }
  .foot__links { display: flex; flex-direction: column; }
  .foot__legal { padding: 20px 0 32px; border-top: 1px solid var(--line); font-size: 13px; color: var(--dim); }

  .wa {
    position: fixed; right: 24px; bottom: 24px; z-index: 80; width: 62px; height: 62px; border-radius: 50%;
    background: #25D366; display: grid; place-items: center; box-shadow: 0 14px 30px -8px rgba(37, 211, 102, .55);
    text-decoration: none;
  }
  .wa::before { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #25D366; animation: waP 2.4s ease-out infinite; }
  @keyframes waP { 0% { transform: scale(1); opacity: .7; } 80%, 100% { transform: scale(1.55); opacity: 0; } }
  @media (max-width: 559px) { .wa { right: 16px; bottom: 16px; width: 56px; height: 56px; } }
</style>
