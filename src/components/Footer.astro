---
import { school, formatPhone, telLink, waLink, formacoes, legal } from '../data/site';
import { units } from '../data/content';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const year = new Date().getFullYear();
interface Props {
  cta?: boolean;
  /** Link e texto do botão de WhatsApp da barra do celular (padrão: agendar visita na escola). */
  wa?: string;
  waLabel?: string;
}
const { cta = true, wa = waLink(school.whatsapp), waLabel = 'Agendar visita' } = Astro.props;

const ensino = [
  { label: 'Educação Infantil', href: `${home}#seg-educacao-infantil` },
  { label: 'Fundamental I', href: `${home}#seg-fundamental-i` },
  { label: 'Fundamental II', href: `${home}#seg-fundamental-ii` },
  { label: 'Ensino Médio', href: `${home}#seg-ensino-medio` },
];
const services = [
  { label: 'Portal Unicollege', href: school.services.unicollege },
  { label: 'Ambiente Virtual EAD', href: school.services.ead },
  { label: 'Webmail', href: school.services.webmail },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<footer class="foot dark">
  <div class="tricolor" aria-hidden="true"><span></span><span></span><span></span></div>

  {cta && <div class="wrap foot__cta">
    <div>
      <p class="kicker">Matrículas {school.enrollmentYear}</p>
      <p class="disp foot__cta-t">Venha conhecer o Êxito <span class="serif">de perto.</span></p>
    </div>
    <div class="foot__cta-btns">
      <a href={waLink(school.whatsapp)} target="_blank" rel="noopener" class="pill-sm pill-sm--wa foot__btn"><Icon name="whatsapp" size={18} />Agendar pelo WhatsApp</a>
      {units[0]?.phones[0] && <a href={telLink(units[0].phones[0].number)} class="ghost ghost--sm foot__btn"><Icon name="phone" size={18} />{formatPhone(units[0].phones[0].number)}</a>}
    </div>
  </div>}

  <div class="wrap foot__grid">
    <div class="foot__brand">
      <a href={home} class="foot__logo" aria-label={`${school.name}, página inicial`}>
        <img src={`${base}/img/logo-horizontal.png`} alt={school.name} width="222" height="40" loading="lazy" />
      </a>
      <p>Da Educação Infantil ao Ensino Médio, com formação profissional na mesma casa. Educando desde {school.foundedYear} no Novo Gama e em Valparaíso de Goiás.</p>
      <div class="foot__social">
        <a href={school.instagramReels} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
        <a href={school.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
        <a href={waLink(school.whatsapp)} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>
      </div>
    </div>

    <nav aria-label="Ensino" class="foot__col">
      <h2>Ensino</h2>
      <ul>{ensino.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav aria-label="Formação profissional" class="foot__col">
      <h2>Formação profissional</h2>
      <ul>
        {formacoes.map((f) => <li><a href={`${base}/${f.slug}`}>{f.name} <small>{f.kind}</small></a></li>)}
        {services.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="foot__col foot__units">
      <h2>Unidades</h2>
      {
        units.map((u) => (
          <address>
            <strong>{u.tag} · {u.city}</strong>
            <span>{u.address[0]}</span>
            {u.phones[0] && <a href={telLink(u.phones[0].number)}>{formatPhone(u.phones[0].number)}</a>}
          </address>
        ))
      }
    </div>
  </div>

  <div class="wrap foot__legal">
    <span>© {year} {school.name}{legal.cnpj && <> · CNPJ {legal.cnpj}</>} · <a href={`mailto:${school.email}`}>{school.email}</a></span>
    <nav aria-label="Documentos legais" class="foot__lgl">
      <a href={`${base}/privacidade`}>Privacidade</a>
      <a href={`${base}/termos`}>Termos de uso</a>
      <a href={`${base}/cookies`}>Cookies</a>
      <a href="#" data-cookie-prefs>Preferências de cookies</a>
    </nav>
    <em>{school.slogan}</em>
  </div>
</footer>

<nav class="mbar" aria-label="Contato rápido">
  {units[0]?.phones[0] && (
    <a href={telLink(units[0].phones[0].number)} class="mbar__call"><Icon name="phone" />Ligar</a>
  )}
  <a href={wa} target="_blank" rel="noopener" class="mbar__wa"><Icon name="whatsapp" />{waLabel}</a>
</nav>

<a href={wa} target="_blank" rel="noopener" class="wa" aria-label="Falar com o Colégio Êxito no WhatsApp">
  <svg aria-hidden="true" width="30" height="30" viewBox="0 0 24 24" fill="#FFFFFF"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.6-.1 1.2z"></path></svg>
</a>

<style>
  .foot { background: var(--navy); color: var(--muted); position: relative; overflow: hidden; }
  .foot::before {
    content: ''; position: absolute; width: 700px; height: 700px; right: -260px; top: -320px; border-radius: 50%;
    background: radial-gradient(circle, rgba(30, 139, 58, .28), transparent 62%); pointer-events: none;
  }
  .tricolor { display: flex; height: 4px; }
  .tricolor span { flex: 1; }
  .tricolor span:nth-child(1) { background: var(--green); }
  .tricolor span:nth-child(2) { background: var(--red); }
  .tricolor span:nth-child(3) { background: #3E6FD8; }

  .foot__cta { position: relative; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; padding: 56px 0 44px; border-bottom: 1px solid var(--line); }
  .foot__cta .kicker { margin: 0; color: #7FD99A; }
  .foot__cta-t { margin: 10px 0 0; font-size: clamp(30px, 4vw, 48px); font-weight: 740; line-height: 1.05; color: #FFFFFF; }
  .foot__cta-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .foot__btn { height: 52px; padding: 0 22px; font-size: 15px; gap: 10px; }

  .foot__grid { position: relative; display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.3fr; gap: 40px; padding: 52px 0 44px; font-size: 14.5px; line-height: 1.6; }
  .foot__brand p { margin: 18px 0 0; max-width: 340px; }
  .foot__logo { display: inline-flex; }
  .foot__logo img { height: 40px; width: auto; }
  .foot__social { display: flex; gap: 10px; margin-top: 22px; }
  .foot__social a {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; color: #FFFFFF;
    background: rgba(255, 255, 255, .08); border: 1px solid var(--line); transition: background .25s, transform .25s var(--ease);
  }
  .foot__social a:hover { background: var(--green); transform: translateY(-3px); }

  .foot__col h2 { margin: 0 0 16px; font-family: var(--f-mono); font-size: 12px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: #7FD99A; }
  .foot__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .foot__col a { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; color: var(--muted); text-decoration: none; transition: color .2s, transform .2s var(--ease); }
  .foot__col a:hover { color: #FFFFFF; transform: translateX(3px); }
  .foot__col small { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: rgba(30, 139, 58, .25); color: #A7EBB9; }
  .foot__units address { font-style: normal; display: grid; gap: 2px; margin-bottom: 16px; }
  .foot__units strong { color: #FFFFFF; }
  .foot__units a { min-height: 32px; }

  .foot__legal { position: relative; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding: 22px 0 30px; border-top: 1px solid var(--line); font-size: 13px; color: var(--dim); }
  .foot__legal em { color: var(--gold); }
  .foot__legal a { color: var(--dim); }
  .foot__legal a:hover { color: #FFFFFF; }
  .foot__lgl { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .foot__lgl a { color: var(--dim); text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .foot__lgl a:hover { color: #FFFFFF; text-decoration: underline; }

  @media (max-width: 1023px) { .foot__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 559px) {
    .foot__grid { grid-template-columns: 1fr; gap: 32px; }
    .foot__btn { flex: 1 1 100%; justify-content: center; }
  }

  .wa {
    position: fixed; right: 24px; bottom: 24px; z-index: 80; width: 62px; height: 62px; border-radius: 50%;
    background: #25D366; display: grid; place-items: center; box-shadow: 0 14px 30px -8px rgba(37, 211, 102, .55);
    text-decoration: none; transition: transform .3s var(--ease);
  }
  .wa:hover { transform: scale(1.08); }
  .wa::before { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #25D366; animation: waP 2.4s ease-out infinite; }
  @keyframes waP { 0% { transform: scale(1); opacity: .7; } 80%, 100% { transform: scale(1.55); opacity: 0; } }

  .mbar { display: none; }
  @media (max-width: 759px) {
    .wa { display: none; }
    .mbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 80; display: grid; grid-template-columns: 1fr 1.6fr; gap: 10px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .94);
      -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-top: 1px solid var(--line2);
      box-shadow: 0 -10px 30px -18px rgba(11, 31, 92, .4);
    }
    .mbar a { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 50px; border-radius: 999px; font-weight: 700; font-size: 15.5px; text-decoration: none; }
    .mbar__call { border: 1px solid var(--line2); color: var(--royal); background: #FFFFFF; }
    .mbar__wa { background: #25D366; color: var(--navy); }
    .foot { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
  }
</style>
