---
import { segments } from '../data/content';
import { formacaoBySegment } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
import Photo from './Photo.astro';

const slug = (s: string) =>
  s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<section id="jornada" class="jornada" aria-labelledby="jornada-t">
  <div class="wrap jornada__head">
    <div class="rv" style="max-width:640px">
      <div class="kicker">A jornada</div>
      <h2 id="jornada-t" class="disp h2">Uma escola para cada fase. <span class="serif">O mesmo cuidado</span> em todas.</h2>
    </div>
    <div class="jornada__nav rv">
      <button type="button" class="jornada__btn" data-dir="-1" aria-label="Fase anterior">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
      </button>
      <button type="button" class="jornada__btn" data-dir="1" aria-label="Próxima fase">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </button>
    </div>
  </div>

  <div class="wrap">
    <ul class="row-x stagger" id="row-x" tabindex="0" aria-label="Segmentos de ensino">
      {
        segments.map((s) => (
          <li class={`seg card rv${s.highlight ? ' seg--hl' : ''}`} id={`seg-${slug(s.name)}`}>
            <Photo src={s.photo} label={`Foto · ${s.name}`} alt={`Alunos do ${s.name} no Colégio Êxito`} ratio="4 / 5" dark={s.highlight} />
            <div class="seg__body">
              {s.age && <span class={`mono seg__tag seg__tag--${s.accent}`}>{s.age.toUpperCase()}</span>}
              <h3 class="disp">{s.name}</h3>
              <p>{s.text}</p>
              {formacaoBySegment(s.name) && (
                <a class="seg__link" href={`${base}/${formacaoBySegment(s.name)!.slug}`}>Conhecer o polo →</a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const row = document.getElementById('row-x');
  document.querySelectorAll<HTMLButtonElement>('.jornada__btn').forEach((b) =>
    b.addEventListener('click', () => {
      if (!row) return;
      const card = row.querySelector<HTMLElement>('.seg');
      const step = card ? card.offsetWidth + 24 : 320;
      row.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
    }),
  );
</script>

<style>
  .jornada { padding: clamp(40px, 6vw, 80px) 0 clamp(90px, 10vw, 140px); }
  .jornada__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 48px; }
  .jornada__nav { display: flex; gap: 10px; }
  .jornada__btn {
    width: 52px; height: 52px; border-radius: 50%; border: 1px solid var(--line2); background: var(--ink);
    color: var(--cream); display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s;
  }
  .jornada__btn:hover { background: var(--royal); color: #FFFFFF; }

  .row-x { list-style: none; margin: 0; display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px 2px 28px; scrollbar-width: none; }
  .row-x::-webkit-scrollbar { display: none; }
  .seg { flex: 0 0 clamp(260px, 26vw, 320px); scroll-snap-align: start; scroll-margin-top: 100px; }
  .seg:nth-child(even) { margin-top: 56px; }
  .seg--hl { background: linear-gradient(180deg, #FDECEC, var(--ink2)); }
  .seg__body { padding: 20px 22px 24px; }
  .seg__tag { font-size: 10.5px; padding: 4px 9px; border-radius: 6px; letter-spacing: .08em; }
  .seg__tag--red { background: rgba(225, 37, 27, .12); color: var(--red-dark); }
  .seg__tag--gold { background: rgba(242, 194, 48, .22); color: #6B5200; }
  .seg h3 { margin: 12px 0 6px; font-size: 24px; font-weight: 700; letter-spacing: -.025em; }
  .seg__link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 6px; font-weight: 700; color: var(--green); text-decoration: none; }
  .seg__link:hover { color: var(--green); text-decoration: underline; }
  .seg p { margin: 0; font-size: 15.5px; line-height: 1.55; color: var(--muted); }

  @media (max-width: 899px) { .seg:nth-child(even) { margin-top: 0; } }
  @media (max-width: 599px) {
    .row-x { gap: 14px; }
    .seg { flex-basis: 82%; }
    .seg :global(.ph) { aspect-ratio: 4 / 3 !important; }
  }
</style>
